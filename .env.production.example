# NeeDo Vite frontend production example.
# Use this when the active Nginx server block proxies /api/v1/* to the formal NeeDo backend.

VITE_API_BASE_URL=/api/v1
VITE_LEGACY_AUTH_BASE_URL=https://t.dackou.com
VITE_LEGACY_AUTHORIZATION=Bearer replace-with-apifox-legacy-prelogin-token
VITE_ENABLE_DEVICE_TOKEN_HEADER=true
VITE_NEEDO_FRONTEND_AUTH_BYPASS=true
