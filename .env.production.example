# NeeDo Vite frontend production example.
# Use this when the active Nginx server block proxies /api/v1/* to the formal NeeDo backend.

VITE_API_BASE_URL=/api/v1
NEEDO_BUILD_TARGET=production
VITE_NEEDO_BUILD_TARGET=production
VITE_ENABLE_DEVICE_TOKEN_HEADER=true

# Production uses only the formal same-origin /api/v1 backend.
# Test credentials, frontend auth bypass, legacy auth, and static demo flags are forbidden.
# GOOGLE_AUTH_CLIENT_ID is public backend config returned by /api/v1/auth/google/init.
# Google Cloud authorized JavaScript origin: https://needo.dackou.com (replace only when the formal production origin changes).
# Google Identity Services ID-token login uses no client secret and no callback redirect URI.
