{
  "name": "needo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "maps:jp:build": "node --max-old-space-size=4096 scripts/build-jp-admin-map.mjs",
    "maps:jp:check": "node scripts/check-jp-admin-map.mjs",
    "dev": "npm run dev:formal",
    "dev:formal": "node scripts/dev-formal.mjs",
    "dev:frontend": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "tsc -b --noEmit",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:quality": "node scripts/i18n-quality-audit.mjs",
    "i18n:export": "node scripts/export-i18n-workbook.mjs",
    "i18n:glossary": "node scripts/export-i18n-glossary-workbook.mjs",
    "i18n:import": "node scripts/import-i18n-workbook.mjs exports/i18n/needo-localization-workbook.xlsx",
    "i18n:screenshots": "node scripts/i18n-page-screenshot-audit.mjs",
    "verify:social-mine": "node scripts/verify-social-mine-route.mjs",
    "audit:production-bundle": "node scripts/audit-production-bundle.mjs",
    "verify:production-build": "npm run build -- --mode formal && npm run audit:production-bundle",
    "verify:production-smoke": "node scripts/production-smoke.mjs",
    "perf:local-baseline": "node scripts/local-performance-baseline.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "pptxgenjs": "4.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "d3-geo": "^3.1.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "stream-json": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "vitest": "^4.1.4"
  }
}
