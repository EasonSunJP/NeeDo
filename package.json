{
  "name": "needo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:frontend": "vite --host 0.0.0.0",
    "dev:static": "VITE_NEEDO_STATIC_DEMO=true vite --host 0.0.0.0",
    "dev:backend": "node scripts/mock-backend.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc -b && vite build",
    "build:static": "tsc -b && VITE_NEEDO_STATIC_DEMO=true vite build",
    "preview": "vite preview --host 0.0.0.0",
    "preview:static": "vite preview --host 0.0.0.0",
    "lint": "tsc -b --noEmit",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:quality": "node scripts/i18n-quality-audit.mjs",
    "i18n:export": "node scripts/export-i18n-workbook.mjs",
    "i18n:import": "node scripts/import-i18n-workbook.mjs exports/i18n/needo-localization-workbook.xlsx",
    "i18n:screenshots": "node scripts/i18n-page-screenshot-audit.mjs",
    "verify:social-mine": "node scripts/verify-social-mine-route.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vitest": "^4.1.4"
  }
}
