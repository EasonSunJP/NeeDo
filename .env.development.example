# NeeDo Vite frontend local development example.
# Default keeps browser requests same-origin as /api/v1 and proxies to the real backend.

VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:3000
NEEDO_BUILD_TARGET=development
VITE_NEEDO_BUILD_TARGET=development
VITE_LEGACY_AUTH_BASE_URL=/legacy-auth
VITE_LEGACY_AUTH_PROXY_TARGET=https://t.dackou.com
VITE_LEGACY_AUTHORIZATION=Bearer replace-with-apifox-legacy-prelogin-token
VITE_NEEDO_FRONTEND_AUTH_BYPASS=true

# GOOGLE_AUTH_CLIENT_ID is public backend config returned by /api/v1/auth/google/init.
# Google Cloud authorized JavaScript origin: http://localhost:5180 (add the exact fallback port only when used).
# Google Identity Services ID-token login uses no client secret and no callback redirect URI.
