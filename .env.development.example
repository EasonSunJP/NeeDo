# NeeDo Vite frontend local development example.
# Default keeps browser requests same-origin as /api/v1 and proxies to the real backend.

VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:3000
VITE_TEST_LOGIN_EMAIL=admin@example.com
VITE_TEST_LOGIN_PASSWORD=Abcd@1234
VITE_TEST_LOGIN_ADMIN_EMAIL=admin@example.com
VITE_TEST_LOGIN_ADMIN_PASSWORD=Abcd@1234
VITE_TEST_LOGIN_CUSTOMER_EMAIL=customer@example.com
VITE_TEST_LOGIN_CUSTOMER_PASSWORD=Abcd@1234
VITE_TEST_LOGIN_MERCHANT_EMAIL=merchant@example.com
VITE_TEST_LOGIN_MERCHANT_PASSWORD=Abcd@1234
VITE_TEST_LOGIN_BUSINESS_EMAIL=affiliate@example.com
VITE_TEST_LOGIN_BUSINESS_PASSWORD=Abcd@1234
VITE_TEST_LOGIN_TECHNICIAN_EMAIL=technician@example.com
VITE_TEST_LOGIN_TECHNICIAN_PASSWORD=Abcd@1234
