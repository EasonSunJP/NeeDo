# NeeDo Vite frontend staging example.
# The built staging frontend must never point to localhost.

STAGING_WEB_URL=https://needo.dackou.com
STAGING_API_BASE_URL=https://t.dackou.com
VITE_API_BASE_URL=https://t.dackou.com
VITE_TEST_LOGIN_EMAIL=admin@example.com
VITE_TEST_LOGIN_PASSWORD=replace-with-staging-test-user-password
VITE_TEST_LOGIN_ADMIN_EMAIL=admin@example.com
VITE_TEST_LOGIN_ADMIN_PASSWORD=replace-with-staging-test-user-password
VITE_TEST_LOGIN_CUSTOMER_EMAIL=customer@example.com
VITE_TEST_LOGIN_CUSTOMER_PASSWORD=replace-with-staging-test-user-password
VITE_TEST_LOGIN_MERCHANT_EMAIL=merchant@example.com
VITE_TEST_LOGIN_MERCHANT_PASSWORD=replace-with-staging-test-user-password
VITE_TEST_LOGIN_TECHNICIAN_EMAIL=technician@example.com
VITE_TEST_LOGIN_TECHNICIAN_PASSWORD=replace-with-staging-test-user-password

# URI examples from the deployed interface docs:
