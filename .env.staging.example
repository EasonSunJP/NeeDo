# NeeDo Vite frontend staging example.
# The built staging frontend must never point to localhost.

STAGING_WEB_URL=https://needo.dackou.com
STAGING_API_BASE_URL=https://needo.dackou.com/api/v1
VITE_API_BASE_URL=/api/v1
VITE_LEGACY_AUTH_BASE_URL=https://t.dackou.com
VITE_API_PUBLIC_AUTHORIZATION=Bearer replace-with-staging-public-prelogin-token
VITE_TEST_LOGIN_EMAIL=admin
VITE_TEST_LOGIN_PASSWORD=Admin.2026
VITE_TEST_LOGIN_ADMIN_EMAIL=admin
VITE_TEST_LOGIN_ADMIN_PASSWORD=Admin.2026
VITE_TEST_LOGIN_CUSTOMER_EMAIL=admin
VITE_TEST_LOGIN_CUSTOMER_PASSWORD=Admin.2026
VITE_TEST_LOGIN_MERCHANT_EMAIL=admin
VITE_TEST_LOGIN_MERCHANT_PASSWORD=Admin.2026
VITE_TEST_LOGIN_BUSINESS_EMAIL=admin
VITE_TEST_LOGIN_BUSINESS_PASSWORD=Admin.2026
VITE_TEST_LOGIN_TECHNICIAN_EMAIL=admin
VITE_TEST_LOGIN_TECHNICIAN_PASSWORD=Admin.2026

# Captcha image requests still use the legacy Apifox pre-login route on t.dackou.com.
