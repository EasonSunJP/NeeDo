# NeeDo Vite frontend staging example.
# The built staging frontend must never point to localhost.

STAGING_WEB_URL=https://test.needo.jp
STAGING_API_BASE_URL=https://api-test.needo.jp/api/v1
VITE_API_BASE_URL=https://api-test.needo.jp/api/v1

# Alternative: set VITE_API_BASE_URL=/api/v1 only when Nginx routes same-origin /api/v1 to staging backend.
