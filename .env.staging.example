# NeeDo Vite frontend staging example.
# The built staging frontend must never point to localhost.

STAGING_WEB_URL=https://needo.dackou.com
STAGING_API_BASE_URL=https://needo.dackou.com/api/v1
NEEDO_BUILD_TARGET=production
VITE_NEEDO_BUILD_TARGET=production
VITE_API_BASE_URL=/api/v1

# Staging uses only the formal same-origin /api/v1 backend.
# Test credentials, frontend auth bypass, legacy auth, and static demo flags are forbidden.
