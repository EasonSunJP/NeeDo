# NeeDo staging backend example.
# Copy to backend/.env.staging and inject real values through deployment secrets.

NODE_ENV=production
DEPLOY_ENV=staging
ALLOW_TEST_LOGIN=false
ALLOW_FORMAL_TEST_SEED=false
ALLOW_SIMULATION_SEED=false
SERVICE_NAME=needo-backend
PORT=3000
API_PREFIX=/api/v1

# Replace these with the actual staging frontend/API domains.
STAGING_WEB_URL=https://needo.dackou.com
STAGING_API_BASE_URL=https://needo.dackou.com/api/v1
API_BASE_URL=https://needo.dackou.com/api/v1
FRONTEND_WEB_URL=https://needo.dackou.com

# Staging frontend must never call localhost. Add every real test domain here.
CORS_ORIGINS=https://needo.dackou.com
TRUST_PROXY=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
REQUEST_BODY_LIMIT=1mb
LOG_LEVEL=info
OPENAPI_ENABLED=true
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=replace-with-staging-metrics-token-32chars-min
TRACING_ENABLED=true
CACHE_PUBLIC_MAX_AGE_SECONDS=30
CACHE_STALE_WHILE_REVALIDATE_SECONDS=120
CDN_BASE_URL=

JWT_ACCESS_SECRET=replace-with-staging-access-token-secret-32chars-min
JWT_REFRESH_SECRET=replace-with-staging-refresh-token-secret-32chars-min
AUTH_VERIFICATION_SECRET=replace-with-a-dedicated-32-character-secret
AUTH_VERIFICATION_MAX_ATTEMPTS=5
AUTH_ACTION_RATE_LIMIT_WINDOW_MS=60000
AUTH_REGISTRATION_RATE_LIMIT_MAX=5
AUTH_GOOGLE_INIT_RATE_LIMIT_MAX=20
AUTH_GOOGLE_CREDENTIAL_RATE_LIMIT_MAX=10
AUTH_VERIFICATION_RATE_LIMIT_MAX=10
AUTH_GOOGLE_NONCE_TTL_SECONDS=300
# Google Identity Services Web OAuth client ID only; inject the actual staging value through deployment secrets.
GOOGLE_AUTH_CLIENT_ID=replace-with-staging-google-web-client-id.apps.googleusercontent.com
GOOGLE_AUTH_VERIFY_TIMEOUT_MS=5000
AFFILIATE_LINK_SECRET=replace-with-staging-affiliate-link-secret-32chars-min
SENSITIVE_DATA_ENCRYPTION_KEY=replace-with-staging-sensitive-data-key-32chars-min
AFFILIATE_PUBLIC_BASE_URL=https://needo.dackou.com/afirieito
IDENTITY_APPLICATION_MEDIA_STORAGE_DIR=runtime/identity-applications
IDENTITY_APPLICATION_PURGE_INTERVAL_MS=3600000
AFFILIATE_TASK_EXPIRY_INTERVAL_MS=300000
AFFILIATE_TASK_EXPIRY_BATCH_SIZE=100
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=300
AUTH_LOGIN_LOCK_SECONDS=300
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_COOLDOWN_SECONDS=60
AUTH_OTP_EMAIL_WEBHOOK_URL=
AUTH_OTP_EMAIL_WEBHOOK_TIMEOUT_MS=3000

ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=replace-with-one-time-staging-bootstrap-password

BACKEND_HOST_PORT=3000
BACKEND_CONTAINER_PORT=3000

DATABASE_URL=mysql://needo_staging:replace-with-staging-db-password@mysql:3306/needo_staging
DATABASE_POOL_CONNECTION_LIMIT=20
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=10000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECT_TIMEOUT_MS=5000
MYSQL_DATABASE=needo_staging
MYSQL_USER=needo_staging
MYSQL_PASSWORD=replace-with-staging-db-password
MYSQL_ROOT_PASSWORD=replace-with-staging-root-password
MYSQL_CONTAINER_PORT=3306

REDIS_PASSWORD=replace-with-staging-redis-password
REDIS_URL=redis://:replace-with-staging-redis-password@redis:6379
REDIS_POOL_SIZE=4
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_RECONNECT_MAX_RETRIES=20
REDIS_RECONNECT_BASE_DELAY_MS=100
REDIS_RECONNECT_MAX_DELAY_MS=3000
REDIS_CONTAINER_PORT=6379
