# NeeDo real backend local development example.
# Copy to backend/.env.dev and replace all secret/password values outside Git.

NODE_ENV=development
DEPLOY_ENV=local
SERVICE_NAME=needo-backend
PORT=3000
API_PREFIX=/api/v1

# Canonical CORS variable. Add any extra Vite fallback port here, separated by comma.
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
REQUEST_BODY_LIMIT=1mb
LOG_LEVEL=info
OPENAPI_ENABLED=true
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=
TRACING_ENABLED=true
CACHE_PUBLIC_MAX_AGE_SECONDS=30
CACHE_STALE_WHILE_REVALIDATE_SECONDS=120
CDN_BASE_URL=

# Local URL contract. Frontend dev should use /api/v1 with Vite proxy, or this full URL.
API_BASE_URL=http://localhost:3000/api/v1
FRONTEND_WEB_URL=http://localhost:5180

# Do not commit real secrets. These are development placeholders only.
JWT_ACCESS_SECRET=replace-with-local-access-token-secret-32chars-min
JWT_REFRESH_SECRET=replace-with-local-refresh-token-secret-32chars-min
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=300
AUTH_LOGIN_LOCK_SECONDS=300
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_COOLDOWN_SECONDS=60
AUTH_OTP_EMAIL_WEBHOOK_URL=http://host.docker.internal:3999/otp/email
AUTH_OTP_EMAIL_WEBHOOK_TIMEOUT_MS=3000

# Seeded accounts. TEST_USER_DEFAULT_PASSWORD is used for all real test accounts.
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=change-this-dev-admin-password
TEST_USER_DEFAULT_PASSWORD=change-this-dev-test-user-password

BACKEND_HOST_PORT=3000
BACKEND_CONTAINER_PORT=3000

DATABASE_URL=mysql://needo_dev:needo_dev_password@localhost:3307/needo_dev
DATABASE_POOL_CONNECTION_LIMIT=10
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=10000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECT_TIMEOUT_MS=5000
MYSQL_DATABASE=needo_dev
MYSQL_USER=needo_dev
MYSQL_PASSWORD=needo_dev_password
MYSQL_ROOT_PASSWORD=needo_root_password
MYSQL_HOST_PORT=3307
MYSQL_CONTAINER_PORT=3306

REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=2
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_RECONNECT_MAX_RETRIES=5
REDIS_RECONNECT_BASE_DELAY_MS=100
REDIS_RECONNECT_MAX_DELAY_MS=3000
REDIS_HOST_PORT=6379
REDIS_CONTAINER_PORT=6379
