# NeeDo real backend local development example.
# Copy to backend/.env.dev and replace all secret/password values outside Git.

NODE_ENV=development
DEPLOY_ENV=local
ALLOW_TEST_LOGIN=true
ALLOW_FORMAL_TEST_SEED=true
ALLOW_SIMULATION_SEED=true
EXCHANGE_SIMULATION_SEED=needo-exchange-2026-08-30
SERVICE_NAME=needo-backend
PORT=3000
API_PREFIX=/api/v1

# Canonical CORS variable. Add any extra Vite fallback port here, separated by comma.
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:5181,http://127.0.0.1:5181,http://localhost:5182,http://127.0.0.1:5182
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
REQUEST_BODY_LIMIT=1mb
LOG_LEVEL=info
OPENAPI_ENABLED=true
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=
TRACING_ENABLED=true
CACHE_PUBLIC_MAX_AGE_SECONDS=30
CACHE_STALE_WHILE_REVALIDATE_SECONDS=120
CDN_BASE_URL=

# Local URL contract. Frontend dev should use /api/v1 with Vite proxy, or this full URL.
API_BASE_URL=http://localhost:3000/api/v1
FRONTEND_WEB_URL=http://localhost:5180

# Do not commit real secrets. These are development placeholders only.
JWT_ACCESS_SECRET=replace-with-local-access-token-secret-32chars-min
JWT_REFRESH_SECRET=replace-with-local-refresh-token-secret-32chars-min
AUTH_TOKEN_AUDIENCE=needo-backend
AUTH_VERIFICATION_SECRET=replace-with-a-dedicated-32-character-secret
AUTH_VERIFICATION_MAX_ATTEMPTS=5
AUTH_ACTION_RATE_LIMIT_WINDOW_MS=60000
AUTH_REGISTRATION_RATE_LIMIT_MAX=5
AUTH_GOOGLE_INIT_RATE_LIMIT_MAX=20
AUTH_GOOGLE_CREDENTIAL_RATE_LIMIT_MAX=10
AUTH_VERIFICATION_RATE_LIMIT_MAX=10
AUTH_GOOGLE_NONCE_TTL_SECONDS=300
# Google Identity Services Web OAuth client ID only; local placeholder is not a usable credential.
GOOGLE_AUTH_CLIENT_ID=replace-with-local-google-web-client-id.apps.googleusercontent.com
GOOGLE_AUTH_VERIFY_TIMEOUT_MS=5000
AFFILIATE_LINK_SECRET=replace-with-local-affiliate-link-secret-32chars-min
SENSITIVE_DATA_ENCRYPTION_KEY=replace-with-local-sensitive-data-key-32chars-min
AFFILIATE_PUBLIC_BASE_URL=http://localhost:5180/afirieito
CUSTOMER_AVATAR_STORAGE_DIR=runtime/customer-avatars
IDENTITY_APPLICATION_MEDIA_STORAGE_DIR=runtime/identity-applications
# dev:formal resolves these legacy defaults against the shared Git checkout.
# Direct backend launches and production must set absolute persistent directories.
IM_MEDIA_STORAGE_DIR=runtime/im-media
IM_MEDIA_PUBLIC_BASE_URL=http://localhost:3000/media/im
CONTENT_MEDIA_STORAGE_DIR=runtime/content-media
CONTENT_PUBLICATION_INTERVAL_MS=60000
CONTENT_PUBLICATION_BATCH_SIZE=50
CONTENT_PUBLICATION_MAX_ACTIVATION_ATTEMPTS=3
IDENTITY_APPLICATION_PURGE_INTERVAL_MS=3600000
IM_PRIVACY_EXPIRY_INTERVAL_MS=1000
IM_PRIVACY_EXPIRY_BATCH_SIZE=50
# Set to deepl only with a separately injected DeepL API Free key.
IM_TRANSLATION_PROVIDER=disabled
IM_TRANSLATION_API_BASE_URL=
IM_TRANSLATION_API_KEY=
IM_TRANSLATION_TIMEOUT_MS=5000
IM_TRANSLATION_MAX_RETRIES=2
# Provider quota policy metadata; no local usage ledger is enabled.
IM_TRANSLATION_MONTHLY_CHARACTER_LIMIT=500000
AFFILIATE_TASK_EXPIRY_INTERVAL_MS=300000
AFFILIATE_TASK_EXPIRY_BATCH_SIZE=100
AFFILIATE_ALLIANCE_INVITATION_EXPIRY_INTERVAL_MS=300000
AFFILIATE_ALLIANCE_INVITATION_EXPIRY_BATCH_SIZE=100
BOOKING_USER_REWARD_EXPIRY_INTERVAL_MS=300000
BOOKING_USER_REWARD_EXPIRY_BATCH_SIZE=100
SHOP_MEMBERSHIP_CARD_ADJUSTMENT_EXPIRY_INTERVAL_MS=300000
SHOP_MEMBERSHIP_CARD_ADJUSTMENT_EXPIRY_BATCH_SIZE=100
EXCHANGE_EXPIRY_WORKER_ENABLED=true
EXCHANGE_EXPIRY_INTERVAL_MS=300000
EXCHANGE_EXPIRY_BATCH_SIZE=100
CUSTOMER_AVATAR_PUBLIC_BASE_URL=http://localhost:3000/media/customer-avatars
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=300
AUTH_LOGIN_LOCK_SECONDS=300
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_COOLDOWN_SECONDS=60
AUTH_OTP_EMAIL_WEBHOOK_URL=http://host.docker.internal:3999/otp/email
AUTH_OTP_EMAIL_WEBHOOK_TIMEOUT_MS=3000

# Local seeded accounts. These values are rejected by a production runtime.
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=Admin.2026
TEST_USER_DEFAULT_PASSWORD=Admin.2026
LIFEDANCE_ADMIN2_PASSWORD=

BACKEND_HOST_PORT=3000
BACKEND_CONTAINER_PORT=3000

DATABASE_URL=mysql://needo_dev:needo_dev_password@127.0.0.1:3307/needo_dev
DATABASE_ALLOW_PUBLIC_KEY_RETRIEVAL=true
DATABASE_POOL_CONNECTION_LIMIT=10
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=10000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECT_TIMEOUT_MS=5000
MYSQL_DATABASE=needo_dev
MYSQL_USER=needo_dev
MYSQL_PASSWORD=needo_dev_password
MYSQL_ROOT_PASSWORD=needo_root_password
MYSQL_HOST_PORT=3307
MYSQL_CONTAINER_PORT=3306

REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=2
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_RECONNECT_MAX_RETRIES=5
REDIS_RECONNECT_BASE_DELAY_MS=100
REDIS_RECONNECT_MAX_DELAY_MS=3000
REALTIME_REDIS_CHANNEL=needo:realtime:events:v1
OFFICIAL_NOTICE_DELIVERY_INTERVAL_MS=60000
OFFICIAL_NOTICE_DELIVERY_BATCH_SIZE=100
OFFICIAL_NOTICE_MAX_DELIVERY_ATTEMPTS=3
REDIS_HOST_PORT=6379
REDIS_CONTAINER_PORT=6379
AUTH_MERCHANT_SHOP_AUDIT_OUTBOX_INTERVAL_MS=5000
AUTH_MERCHANT_SHOP_AUDIT_OUTBOX_DRAIN_TIMEOUT_MS=3000
AUTH_MERCHANT_SHOP_AUDIT_OUTBOX_SHUTDOWN_TIMEOUT_MS=1000
