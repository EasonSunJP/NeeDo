NODE_ENV=development
DEPLOY_ENV=local
SERVICE_NAME=needo-backend
PORT=3100
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
REQUEST_BODY_LIMIT=1mb
LOG_LEVEL=info
OPENAPI_ENABLED=true
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=
TRACING_ENABLED=true
CACHE_PUBLIC_MAX_AGE_SECONDS=30
CACHE_STALE_WHILE_REVALIDATE_SECONDS=120
CDN_BASE_URL=
ADMIN_DEFAULT_PASSWORD=change-this-dev-admin-password
AUTH_ACCESS_TOKEN_SECRET=replace-with-local-access-token-secret-32chars-min
AUTH_REFRESH_TOKEN_SECRET=replace-with-local-refresh-token-secret-32chars-min
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=300
AUTH_LOGIN_LOCK_SECONDS=300
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_COOLDOWN_SECONDS=60
AUTH_OTP_EMAIL_WEBHOOK_URL=http://host.docker.internal:3999/otp/email
AUTH_OTP_EMAIL_WEBHOOK_TIMEOUT_MS=3000
AUTH_TEST_LOGIN_ENABLED=true

BACKEND_HOST_PORT=3100
BACKEND_CONTAINER_PORT=3100

DATABASE_URL=mysql://needo_dev:needo_dev_password@mysql:3306/needo_dev
DATABASE_POOL_CONNECTION_LIMIT=10
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=10000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECT_TIMEOUT_MS=5000
MYSQL_DATABASE=needo_dev
MYSQL_USER=needo_dev
MYSQL_PASSWORD=needo_dev_password
MYSQL_ROOT_PASSWORD=needo_root_password
MYSQL_HOST_PORT=3307
MYSQL_CONTAINER_PORT=3306

REDIS_URL=redis://redis:6379
REDIS_POOL_SIZE=2
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_RECONNECT_MAX_RETRIES=5
REDIS_RECONNECT_BASE_DELAY_MS=100
REDIS_RECONNECT_MAX_DELAY_MS=3000
REDIS_HOST_PORT=6379
REDIS_CONTAINER_PORT=6379
