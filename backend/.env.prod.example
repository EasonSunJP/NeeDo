NODE_ENV=production
DEPLOY_ENV=prod
ALLOW_TEST_LOGIN=false
ALLOW_FORMAL_TEST_SEED=false
ALLOW_SIMULATION_SEED=false
SERVICE_NAME=needo-backend
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGINS=https://needo.dackou.com
TRUST_PROXY=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1200
REQUEST_BODY_LIMIT=1mb
LOG_LEVEL=info
OPENAPI_ENABLED=false
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=replace-with-prod-metrics-token-32chars-min
TRACING_ENABLED=true
CACHE_PUBLIC_MAX_AGE_SECONDS=60
CACHE_STALE_WHILE_REVALIDATE_SECONDS=300
CDN_BASE_URL=
ADMIN_DEFAULT_PASSWORD=replace-with-one-time-prod-bootstrap-password
JWT_ACCESS_SECRET=replace-with-prod-access-token-secret-32chars-min
JWT_REFRESH_SECRET=replace-with-prod-refresh-token-secret-32chars-min
AUTH_VERIFICATION_SECRET=replace-with-a-dedicated-32-character-secret
AUTH_VERIFICATION_MAX_ATTEMPTS=5
AUTH_ACTION_RATE_LIMIT_WINDOW_MS=60000
AUTH_REGISTRATION_RATE_LIMIT_MAX=5
AUTH_GOOGLE_INIT_RATE_LIMIT_MAX=20
AUTH_GOOGLE_CREDENTIAL_RATE_LIMIT_MAX=10
AUTH_VERIFICATION_RATE_LIMIT_MAX=10
AUTH_GOOGLE_NONCE_TTL_SECONDS=300
# Google Identity Services Web OAuth client ID only; inject the production value through deployment secrets.
GOOGLE_AUTH_CLIENT_ID=replace-with-prod-google-web-client-id.apps.googleusercontent.com
GOOGLE_AUTH_VERIFY_TIMEOUT_MS=5000
AFFILIATE_LINK_SECRET=replace-with-prod-affiliate-link-secret-32chars-min
SENSITIVE_DATA_ENCRYPTION_KEY=replace-with-prod-sensitive-data-key-32chars-min
AFFILIATE_PUBLIC_BASE_URL=https://needo.dackou.com/afirieito
IDENTITY_APPLICATION_MEDIA_STORAGE_DIR=runtime/identity-applications
IDENTITY_APPLICATION_PURGE_INTERVAL_MS=3600000
AFFILIATE_TASK_EXPIRY_INTERVAL_MS=300000
AFFILIATE_TASK_EXPIRY_BATCH_SIZE=100
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=300
AUTH_LOGIN_LOCK_SECONDS=300
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_COOLDOWN_SECONDS=60
AUTH_OTP_EMAIL_WEBHOOK_URL=
AUTH_OTP_EMAIL_WEBHOOK_TIMEOUT_MS=3000
EXCHANGE_EXPIRY_WORKER_ENABLED=true
EXCHANGE_EXPIRY_INTERVAL_MS=300000
EXCHANGE_EXPIRY_BATCH_SIZE=100

BACKEND_HOST_PORT=3000
BACKEND_CONTAINER_PORT=3000

DATABASE_URL=mysql://needo_prod:replace-with-prod-db-password@mysql:3306/needo_prod
DATABASE_POOL_CONNECTION_LIMIT=40
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=10000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECT_TIMEOUT_MS=5000
MYSQL_DATABASE=needo_prod
MYSQL_USER=needo_prod
MYSQL_PASSWORD=replace-with-prod-db-password
MYSQL_ROOT_PASSWORD=replace-with-prod-root-password
MYSQL_CONTAINER_PORT=3306

REDIS_PASSWORD=replace-with-prod-redis-password
REDIS_URL=redis://:replace-with-prod-redis-password@redis:6379
REDIS_POOL_SIZE=8
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_RECONNECT_MAX_RETRIES=30
REDIS_RECONNECT_BASE_DELAY_MS=100
REDIS_RECONNECT_MAX_DELAY_MS=3000
REALTIME_REDIS_CHANNEL=needo:realtime:events:v1
REDIS_CONTAINER_PORT=6379
