NODE_ENV=production
DEPLOY_ENV=prod
SERVICE_NAME=needo-backend
PORT=3100
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=https://needo.example,https://admin.needo.example
TRUST_PROXY=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1200
REQUEST_BODY_LIMIT=1mb
LOG_LEVEL=info
OPENAPI_ENABLED=false
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=replace-with-prod-metrics-token-32chars-min
TRACING_ENABLED=true
CACHE_PUBLIC_MAX_AGE_SECONDS=60
CACHE_STALE_WHILE_REVALIDATE_SECONDS=300
CDN_BASE_URL=https://cdn.needo.example
ADMIN_DEFAULT_PASSWORD=replace-with-one-time-prod-bootstrap-password
AUTH_ACCESS_TOKEN_SECRET=replace-with-prod-access-token-secret-32chars-min
AUTH_REFRESH_TOKEN_SECRET=replace-with-prod-refresh-token-secret-32chars-min
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=300
AUTH_LOGIN_LOCK_SECONDS=300
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_COOLDOWN_SECONDS=60
AUTH_OTP_EMAIL_WEBHOOK_URL=
AUTH_OTP_EMAIL_WEBHOOK_TIMEOUT_MS=3000
AUTH_TEST_LOGIN_ENABLED=false

BACKEND_HOST_PORT=3100
BACKEND_CONTAINER_PORT=3100

DATABASE_URL=mysql://needo_prod:replace-with-prod-db-password@mysql:3306/needo_prod
DATABASE_POOL_CONNECTION_LIMIT=40
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=10000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECT_TIMEOUT_MS=5000
MYSQL_DATABASE=needo_prod
MYSQL_USER=needo_prod
MYSQL_PASSWORD=replace-with-prod-db-password
MYSQL_ROOT_PASSWORD=replace-with-prod-root-password
MYSQL_CONTAINER_PORT=3306

REDIS_URL=redis://redis:6379
REDIS_POOL_SIZE=8
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_RECONNECT_MAX_RETRIES=30
REDIS_RECONNECT_BASE_DELAY_MS=100
REDIS_RECONNECT_MAX_DELAY_MS=3000
REDIS_CONTAINER_PORT=6379
