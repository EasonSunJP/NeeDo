  idempotencyKey            String                             @unique(map: "shop_membership_card_redemptions_idempotency_key") @map("idempotency_key") @db.VarChar(160)
  requestFingerprint        String                             @map("request_fingerprint") @db.Char(64)
  createdAt                 DateTime                           @default(now()) @map("created_at")
  updatedAt                 DateTime                           @updatedAt @map("updated_at")
  deletedAt                 DateTime?                          @map("deleted_at")

  card              ShopMembershipCard                  @relation(fields: [cardId], references: [id], onDelete: Restrict)
  shop              Shop                                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer          User                                @relation("ShopMembershipCardRedemptionCustomer", fields: [customerUserId], references: [id], onDelete: Restrict)
