  totalShopDebitNdp         Int                                @default(0) @map("total_shop_debit_ndp")
  rewardCapped              Boolean                            @default(false) @map("reward_capped")
  rewardStatus              ShopMembershipCardRewardStatus     @default(NONE) @map("reward_status")
  outstandingRewardNdp      Int                                @default(0) @map("outstanding_reward_ndp")
  shopWalletId              Int?                               @map("shop_wallet_id")
  customerWalletId          Int?                               @map("customer_wallet_id")
  platformWalletId          Int?                               @map("platform_wallet_id")
  ledgerTransactionId       Int?                               @unique(map: "shop_membership_card_redemptions_ledger_transaction_id_key") @map("ledger_transaction_id")
  status                    ShopMembershipCardRedemptionStatus @default(APPLIED)
