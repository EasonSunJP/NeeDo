model User {
  id                   Int                  @id @default(autoincrement())
  needoId              String               @unique @map("needo_id") @db.VarChar(32)
  accountNo            String?              @unique @map("account_no") @db.Char(10)
  primaryIdentityType  PrimaryIdentityType? @map("primary_identity_type")
  email                String               @unique @db.VarChar(255)
  phone                String?              @unique @db.VarChar(32)
  emailVerifiedAt      DateTime?            @map("email_verified_at")
  passwordHash         String?              @map("password_hash") @db.VarChar(255)
  username             String               @db.VarChar(100)
  avatarUrl            String?              @map("avatar_url") @db.VarChar(500)
  avatarBootstrapUrl   String?              @map("avatar_bootstrap_url") @db.VarChar(500)
  avatarBootstrappedAt DateTime?            @map("avatar_bootstrapped_at")
  isActive             Boolean              @default(true) @map("is_active")
  isTestAccount        Boolean              @default(false) @map("is_test_account")
  sessionGeneration    Int                  @default(0) @map("session_generation")
  lastLoginAt          DateTime?            @map("last_login_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  deletedAt            DateTime?            @map("deleted_at")

  identities                              UserIdentity[]
  userRoles                               UserRole[]
  loginLogs                               LoginLog[]                            @relation("LoginLogUser")
