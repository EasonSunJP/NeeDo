  publicId          String                       @unique @default(uuid()) @map("public_id") @db.Char(36)
  shopId            Int                          @map("shop_id")
  customerProfileId Int                          @map("customer_profile_id")
  status            ShopCustomerMembershipStatus @default(ACTIVE)
  source            ShopCustomerMembershipSource @default(MERCHANT_MANUAL)
  activeKey         String?                      @unique(map: "shop_customer_memberships_active_key_key") @map("active_key") @db.VarChar(191)
  startedAt         DateTime                     @default(now()) @map("started_at")
  endedAt           DateTime?                    @map("ended_at")
  createdById       Int?                         @map("created_by_id")
  updatedById       Int?                         @map("updated_by_id")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  deletedAt         DateTime?                    @map("deleted_at")

  shop            Shop                 @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customerProfile CustomerProfile      @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  createdBy       User?                @relation("ShopMembershipCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?                @relation("ShopMembershipUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  cards           ShopMembershipCard[]

  @@index([shopId, status, startedAt, deletedAt], map: "shop_customer_memberships_shop_status_idx")
  @@index([customerProfileId, status, startedAt, deletedAt], map: "shop_customer_memberships_customer_status_idx")
  @@index([createdById], map: "shop_customer_memberships_created_by_idx")
  @@index([updatedById], map: "shop_customer_memberships_updated_by_idx")
  @@index([deletedAt], map: "shop_customer_memberships_deleted_idx")
  @@map("shop_customer_memberships")
}

model ShopMembershipCard {
  id                         Int                               @id @default(autoincrement())
  publicId                   String                            @unique @default(uuid()) @map("public_id") @db.Char(36)
  membershipId               Int                               @map("membership_id")
  planId                     Int?                              @map("plan_id")
  planVersionId              Int?                              @map("plan_version_id")
  issuedById                 Int?                              @map("issued_by_id")
  cardNo                     String                            @unique @map("card_no") @db.VarChar(40)
  name                       String                            @db.VarChar(120)
  type                       ShopMembershipCardType
  status                     ShopMembershipCardStatus          @default(ACTIVE)
  issuanceSource             ShopMembershipCardIssuanceSource? @map("issuance_source")
  issuanceReference          String?                           @map("issuance_reference") @db.VarChar(160)
  issuanceNote               String?                           @map("issuance_note") @db.VarChar(500)
  initialPrincipalJpy        Int?                              @map("initial_principal_jpy")
  initialUses                Int?                              @map("initial_uses")
  platformFeeRateBpsSnapshot Int?                              @map("platform_fee_rate_bps_snapshot")
  issuanceIdempotencyKey     String?                           @unique(map: "shop_membership_cards_issuance_idempotency_key") @map("issuance_idempotency_key") @db.VarChar(160)
  issuanceFingerprint        String?                           @map("issuance_fingerprint") @db.Char(64)
  lockVersion                Int                               @default(1) @map("lock_version")
  principalBalanceJpy        Int?                              @map("principal_balance_jpy")
  bonusBalanceJpy            Int?                              @map("bonus_balance_jpy")
  remainingUses              Int?                              @map("remaining_uses")
  totalUses                  Int?                              @map("total_uses")
  issuedAt                   DateTime                          @map("issued_at")
  expiresAt                  DateTime?                         @map("expires_at")
  frozenAt                   DateTime?                         @map("frozen_at")
  createdAt                  DateTime                          @default(now()) @map("created_at")
  updatedAt                  DateTime                          @updatedAt @map("updated_at")
  deletedAt                  DateTime?                         @map("deleted_at")

  membership  ShopCustomerMembership                @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  plan        ShopMembershipCardPlan?               @relation("ShopMembershipCardPlanCards", fields: [planId], references: [id], onDelete: Restrict)
  planVersion ShopMembershipCardPlanVersion?        @relation("ShopMembershipCardPlanVersionCards", fields: [planVersionId], references: [id], onDelete: Restrict)
  issuedBy    User?                                 @relation("ShopMembershipCardIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  adjustments ShopMembershipCardAdjustmentRequest[]
  topUps      ShopMembershipCardTopUp[]
  redemptions ShopMembershipCardRedemption[]
  refunds     ShopMembershipCardRedemptionRefund[]

  @@index([membershipId, status, deletedAt], map: "shop_membership_cards_membership_status_idx")
  @@index([planId, deletedAt], map: "shop_membership_cards_plan_idx")
  @@index([planVersionId, deletedAt], map: "shop_membership_cards_plan_version_idx")
  @@index([issuedById], map: "shop_membership_cards_issued_by_idx")
  @@index([status, expiresAt, deletedAt], map: "shop_membership_cards_status_expiry_idx")
  @@index([deletedAt], map: "shop_membership_cards_deleted_idx")
  @@map("shop_membership_cards")
}

model ShopMembershipCardAdjustmentRequest {
  id                        Int                                @id @default(autoincrement())
  publicId                  String                             @unique @default(uuid()) @map("public_id") @db.Char(36)
  cardId                    Int                                @map("card_id")
  shopId                    Int                                @map("shop_id")
  requestedById             Int                                @map("requested_by_id")
  status                    ShopMembershipCardAdjustmentStatus @default(PENDING)
  pendingKey                String?                            @unique(map: "shop_membership_card_adjustments_pending_key") @map("pending_key") @db.VarChar(191)
  reason                    String                             @db.VarChar(500)
  beforePrincipalBalanceJpy Int?                               @map("before_principal_balance_jpy")
  targetPrincipalBalanceJpy Int?                               @map("target_principal_balance_jpy")
  beforeRemainingUses       Int?                               @map("before_remaining_uses")
  targetRemainingUses       Int?                               @map("target_remaining_uses")
  cardLockVersionBefore     Int                                @map("card_lock_version_before")
  requestIdempotencyKey     String                             @unique(map: "shop_membership_card_adjustments_request_idempotency_key") @map("request_idempotency_key") @db.VarChar(160)
  requestFingerprint        String                             @map("request_fingerprint") @db.Char(64)
  decisionIdempotencyKey    String?                            @unique(map: "shop_membership_card_adjustments_decision_idempotency_key") @map("decision_idempotency_key") @db.VarChar(160)
  decisionFingerprint       String?                            @map("decision_fingerprint") @db.Char(64)
  expiresAt                 DateTime                           @map("expires_at")
  decidedAt                 DateTime?                          @map("decided_at")
  decidedById               Int?                               @map("decided_by_id")
  cancelledAt               DateTime?                          @map("cancelled_at")
  cancelledById             Int?                               @map("cancelled_by_id")
  invalidatedAt             DateTime?                          @map("invalidated_at")
  createdAt                 DateTime                           @default(now()) @map("created_at")
  updatedAt                 DateTime                           @updatedAt @map("updated_at")
  deletedAt                 DateTime?                          @map("deleted_at")

  card        ShopMembershipCard @relation(fields: [cardId], references: [id], onDelete: Restrict)
  shop        Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  requestedBy User               @relation("ShopMembershipCardAdjustmentRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User?              @relation("ShopMembershipCardAdjustmentDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  cancelledBy User?              @relation("ShopMembershipCardAdjustmentCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([cardId, status, createdAt, deletedAt], map: "shop_membership_card_adjustments_card_status_idx")
  @@index([shopId, status, createdAt, deletedAt], map: "shop_membership_card_adjustments_shop_status_idx")
  @@index([status, expiresAt, deletedAt], map: "shop_membership_card_adjustments_status_expiry_idx")
  @@index([requestedById], map: "shop_membership_card_adjustments_requested_by_idx")
  @@index([decidedById], map: "shop_membership_card_adjustments_decided_by_idx")
  @@index([cancelledById], map: "shop_membership_card_adjustments_cancelled_by_idx")
  @@index([deletedAt], map: "shop_membership_card_adjustments_deleted_idx")
  @@map("shop_membership_card_adjustment_requests")
}

