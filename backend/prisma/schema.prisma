  planVersion       ShopMembershipCardPlanVersion       @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  redeemedBy        User                                @relation("ShopMembershipCardRedemptionRedeemedBy", fields: [redeemedById], references: [id], onDelete: Restrict)
  shopWallet        Wallet?                             @relation("ShopMembershipRedemptionShopWallet", fields: [shopWalletId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customerWallet    Wallet?                             @relation("ShopMembershipRedemptionCustomerWallet", fields: [customerWalletId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  platformWallet    Wallet?                             @relation("ShopMembershipRedemptionPlatformWallet", fields: [platformWalletId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ledgerTransaction LedgerTransaction?                  @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  refund            ShopMembershipCardRedemptionRefund?

  @@index([cardId, redeemedAt, deletedAt], map: "shop_membership_card_redemptions_card_redeemed_idx")
  @@index([shopId, redeemedAt, deletedAt], map: "shop_membership_card_redemptions_shop_redeemed_idx")
  @@index([customerUserId, redeemedAt, deletedAt], map: "shop_membership_card_redemptions_customer_redeemed_idx")
  @@index([planVersionId], map: "shop_membership_card_redemptions_plan_version_idx")
  @@index([redeemedById], map: "shop_membership_card_redemptions_redeemed_by_idx")
  @@index([rewardStatus, redeemedAt, deletedAt], map: "shop_membership_card_redemptions_reward_status_idx")
  @@index([shopWalletId], map: "shop_membership_card_redemptions_shop_wallet_idx")
  @@index([customerWalletId], map: "shop_membership_card_redemptions_customer_wallet_idx")
  @@index([platformWalletId], map: "shop_membership_card_redemptions_platform_wallet_idx")
  @@index([status, redeemedAt, deletedAt], map: "shop_membership_card_redemptions_status_idx")
  @@index([deletedAt], map: "shop_membership_card_redemptions_deleted_idx")
  @@map("shop_membership_card_redemptions")
}

model ShopMembershipCardRedemptionRefund {
  id                          Int                                @id @default(autoincrement())
  publicId                    String                             @unique @default(uuid()) @map("public_id") @db.Char(36)
  redemptionId                Int                                @unique(map: "shop_membership_card_redemption_refunds_redemption_id_key") @map("redemption_id")
  cardId                      Int                                @map("card_id")
  shopId                      Int                                @map("shop_id")
  bookingOrderId              Int                                @unique(map: "shop_membership_card_redemption_refunds_booking_order_id_key") @map("booking_order_id")
  customerUserId              Int                                @map("customer_user_id")
  refundedById                Int                                @map("refunded_by_id")
  reason                      String                             @db.VarChar(500)
  orderPaymentRefundedAt      DateTime                           @map("order_payment_refunded_at")
  orderPaymentRefundReference String?                            @map("order_payment_refund_reference") @db.VarChar(120)
  redemptionStatusBefore      ShopMembershipCardRedemptionStatus @map("redemption_status_before")
  rewardStatusBefore          ShopMembershipCardRewardStatus     @map("reward_status_before")
  restoredPrincipalJpy        Int                                @default(0) @map("restored_principal_jpy")
  restoredUses                Int                                @default(0) @map("restored_uses")
  principalBalanceBeforeJpy   Int?                               @map("principal_balance_before_jpy")
  principalBalanceAfterJpy    Int?                               @map("principal_balance_after_jpy")
  remainingUsesBefore         Int?                               @map("remaining_uses_before")
  remainingUsesAfter          Int?                               @map("remaining_uses_after")
  cardLockVersionBefore       Int                                @map("card_lock_version_before")
  reversalMode                ShopMembershipRewardReversalMode   @map("reversal_mode")
  customerRewardReversedNdp   Int                                @default(0) @map("customer_reward_reversed_ndp")
  platformFeeReversedNdp      Int                                @default(0) @map("platform_fee_reversed_ndp")
  totalShopCreditNdp          Int                                @default(0) @map("total_shop_credit_ndp")
  shopWalletId                Int?                               @map("shop_wallet_id")
  customerWalletId            Int?                               @map("customer_wallet_id")
  platformWalletId            Int?                               @map("platform_wallet_id")
  customerBalanceBeforeNdp    Int?                               @map("customer_balance_before_ndp")
  customerBalanceAfterNdp     Int?                               @map("customer_balance_after_ndp")
  reversalLedgerTransactionId Int?                               @unique(map: "shop_membership_card_refund_reversal_ledger_tx_key") @map("reversal_ledger_transaction_id")
  status                      ShopMembershipCardRefundStatus     @default(APPLIED)
  refundedAt                  DateTime                           @default(now()) @map("refunded_at")
  idempotencyKey              String                             @unique(map: "shop_membership_card_redemption_refunds_idempotency_key") @map("idempotency_key") @db.VarChar(160)
  requestFingerprint          String                             @map("request_fingerprint") @db.Char(64)
  createdAt                   DateTime                           @default(now()) @map("created_at")
  updatedAt                   DateTime                           @updatedAt @map("updated_at")
  deletedAt                   DateTime?                          @map("deleted_at")

  redemption                ShopMembershipCardRedemption @relation(fields: [redemptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  card                      ShopMembershipCard           @relation(fields: [cardId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  shop                      Shop                         @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bookingOrder              BookingOrder                 @relation(fields: [bookingOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer                  User                         @relation("ShopMembershipCardRedemptionRefundCustomer", fields: [customerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  refundedBy                User                         @relation("ShopMembershipCardRedemptionRefundedBy", fields: [refundedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  shopWallet                Wallet?                      @relation("ShopMembershipRefundShopWallet", fields: [shopWalletId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customerWallet            Wallet?                      @relation("ShopMembershipRefundCustomerWallet", fields: [customerWalletId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  platformWallet            Wallet?                      @relation("ShopMembershipRefundPlatformWallet", fields: [platformWalletId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversalLedgerTransaction LedgerTransaction?           @relation(fields: [reversalLedgerTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([cardId, refundedAt, deletedAt], map: "shop_membership_card_redemption_refunds_card_idx")
  @@index([shopId, refundedAt, deletedAt], map: "shop_membership_card_redemption_refunds_shop_idx")
  @@index([customerUserId, refundedAt, deletedAt], map: "shop_membership_card_redemption_refunds_customer_idx")
  @@index([refundedById], map: "shop_membership_card_redemption_refunds_refunded_by_idx")
  @@index([shopWalletId], map: "shop_membership_card_redemption_refunds_shop_wallet_idx")
  @@index([customerWalletId], map: "shop_membership_card_redemption_refunds_customer_wallet_idx")
  @@index([platformWalletId], map: "shop_membership_card_redemption_refunds_platform_wallet_idx")
  @@index([status, refundedAt, deletedAt], map: "shop_membership_card_redemption_refunds_status_idx")
  @@index([deletedAt], map: "shop_membership_card_redemption_refunds_deleted_idx")
  @@map("shop_membership_card_redemption_refunds")
}

