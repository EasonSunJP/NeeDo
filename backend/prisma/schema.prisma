generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum OrderType {
  BOOKING @map("booking")
  REQUEST @map("request")

  @@map("order_type")
}

enum BookingOrderStatus {
  PENDING    @map("pending")
  CONFIRMED  @map("confirmed")
  IN_SERVICE @map("in_service")
  COMPLETED  @map("completed")
  CANCELLED  @map("cancelled")

  @@map("booking_order_status")
}

enum ServicePaymentMethod {
  ONSITE        @map("onsite")
  BANK_TRANSFER @map("bank_transfer")

  @@map("service_payment_method")
}

enum ServicePaymentStatus {
  PENDING        @map("pending")
  CONFIRMED      @map("confirmed")
  REFUND_PENDING @map("refund_pending")
  REFUNDED       @map("refunded")

  @@map("service_payment_status")
}

enum ScheduleSlotStatus {
  AVAILABLE @map("available")
  BOOKED    @map("booked")
  BLOCKED   @map("blocked")

  @@map("schedule_slot_status")
}

enum ShopPricingMode {
  MERCHANT   @map("merchant")
  TECHNICIAN @map("technician")

  @@map("shop_pricing_mode")
}

enum ServiceOwnerType {
  SHOP       @map("shop")
  TECHNICIAN @map("technician")

  @@map("service_owner_type")
}

enum TechnicianServiceReviewStatus {
  DRAFT    @map("draft")
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")

  @@map("technician_service_review_status")
}

enum WalletOwnerType {
  USER             @map("user")
  SHOP             @map("shop")
  PLATFORM         @map("platform")
  MERCHANT_ACCOUNT @map("merchant_account")

  @@map("wallet_owner_type")
}

enum WalletAdjustmentType {
  TOPUP      @map("topup")
  WITHDRAWAL @map("withdrawal")

  @@map("wallet_adjustment_type")
}

enum WalletAdjustmentStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")

  @@map("wallet_adjustment_status")
}

enum LedgerTransactionType {
  BOOKING_ACCEPT_FREEZE                @map("booking_accept_freeze")
  BOOKING_CANCEL_UNFREEZE              @map("booking_cancel_unfreeze")
  BOOKING_COMPLETE_SETTLEMENT          @map("booking_complete_settlement")
  BOOKING_MERCHANT_CANCEL_COMPENSATION @map("booking_merchant_cancel_compensation")
  MANUAL_TOPUP_APPROVED                @map("manual_topup_approved")
  MANUAL_WITHDRAWAL_APPROVED           @map("manual_withdrawal_approved")
  SEED_CREDIT                          @map("seed_credit")
  AFFILIATE_TASK_BUDGET_FREEZE         @map("affiliate_task_budget_freeze")
  AFFILIATE_TASK_BUDGET_RELEASE        @map("affiliate_task_budget_release")
  AFFILIATE_REWARD_SETTLEMENT          @map("affiliate_reward_settlement")
  AFFILIATE_REWARD_REVERSAL            @map("affiliate_reward_reversal")
  AFFILIATE_REWARD_RECOVERY            @map("affiliate_reward_recovery")

  @@map("ledger_transaction_type")
}

enum LedgerTransactionStatus {
  APPLIED @map("applied")

  @@map("ledger_transaction_status")
}

enum WalletLedgerDirection {
  AVAILABLE_CREDIT @map("available_credit")
  AVAILABLE_DEBIT  @map("available_debit")
  FREEZE           @map("freeze")
  UNFREEZE         @map("unfreeze")
  FROZEN_DEBIT     @map("frozen_debit")
  FROZEN_CREDIT    @map("frozen_credit")

  @@map("wallet_ledger_direction")
}

enum AffiliatePublisherType {
  MERCHANT_ACCOUNT @map("merchant_account")
  SHOP             @map("shop")

  @@map("affiliate_publisher_type")
}

enum AffiliateServiceScopeMode {
  ALL_CURRENT_SERVICES @map("all_current_services")
  SELECTED_SERVICES    @map("selected_services")

  @@map("affiliate_service_scope_mode")
}

enum AffiliateDiscountType {
  NONE      @map("none")
  FIXED_JPY @map("fixed_jpy")
  PERCENT   @map("percent")

  @@map("affiliate_discount_type")
}

enum AffiliateTaskStatus {
  DRAFT            @map("draft")
  PENDING_REVIEW   @map("pending_review")
  SCHEDULED        @map("scheduled")
  ACTIVE           @map("active")
  PAUSED           @map("paused")
  BUDGET_EXHAUSTED @map("budget_exhausted")
  ENDED            @map("ended")
  CANCELLED        @map("cancelled")
  REJECTED         @map("rejected")

  @@map("affiliate_task_status")
}

enum AffiliateClaimStatus {
  ACTIVE  @map("active")
  EXPIRED @map("expired")
  REVOKED @map("revoked")

  @@map("affiliate_claim_status")
}

enum AffiliateTouchSource {
  URL  @map("url")
  CODE @map("code")

  @@map("affiliate_touch_source")
}

enum AffiliateAttributionStatus {
  ATTRIBUTED  @map("attributed")
  QUALIFIED   @map("qualified")
  SETTLED     @map("settled")
  INVALIDATED @map("invalidated")
  REVERSED    @map("reversed")

  @@map("affiliate_attribution_status")
}

enum AffiliateRewardStatus {
  PENDING          @map("pending")
  SETTLED          @map("settled")
  REVERSED         @map("reversed")
  REVERSAL_PENDING @map("reversal_pending")

  @@map("affiliate_reward_status")
}

enum AffiliateBudgetStatus {
  ACTIVE    @map("active")
  EXHAUSTED @map("exhausted")
  RELEASED  @map("released")

  @@map("affiliate_budget_status")
}

enum AffiliateTransactionKind {
  FREEZE     @map("freeze")
  RELEASE    @map("release")
  SETTLEMENT @map("settlement")
  REVERSAL   @map("reversal")
  RECOVERY   @map("recovery")

  @@map("affiliate_transaction_kind")
}

enum AffiliateRiskSeverity {
  LOW      @map("low")
  MEDIUM   @map("medium")
  HIGH     @map("high")
  CRITICAL @map("critical")

  @@map("affiliate_risk_severity")
}

enum AffiliateRiskStatus {
  OPEN      @map("open")
  REVIEWING @map("reviewing")
  RELEASED  @map("released")
  REJECTED  @map("rejected")

  @@map("affiliate_risk_status")
}

enum FinanceReconciliationStatus {
  PENDING  @map("pending")
  EXPORTED @map("exported")

  @@map("finance_reconciliation_status")
}

enum ConversationType {
  DIRECT @map("direct")
  GROUP  @map("group")

  @@map("conversation_type")
}

enum MessageType {
  TEXT         @map("text")
  SYSTEM       @map("system")
  ORDER_STATUS @map("order_status")

  @@map("message_type")
}

enum FriendRequestStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  REJECTED @map("rejected")

  @@map("friend_request_status")
}

enum SocialPostVisibility {
  PUBLIC    @map("public")
  FOLLOWERS @map("followers")

  @@map("social_post_visibility")
}

enum NotificationType {
  ORDER_STATUS   @map("order_status")
  FRIEND_REQUEST @map("friend_request")
  SYSTEM         @map("system")
  SOCIAL         @map("social")

  @@map("notification_type")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(255)
  phone        String?   @unique @db.VarChar(32)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  username     String    @db.VarChar(100)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  identities                      UserIdentity[]
  userRoles                       UserRole[]
  loginLogs                       LoginLog[]                 @relation("LoginLogUser")
  auditLogs                       AuditLog[]                 @relation("AuditLogActor")
  ledgerTransactions              LedgerTransaction[]        @relation("LedgerTransactionActor")
  requestedWalletAdjustments      WalletAdjustmentRequest[]  @relation("WalletAdjustmentRequestedBy")
  reviewedWalletAdjustments       WalletAdjustmentRequest[]  @relation("WalletAdjustmentReviewedBy")
  ownedShops                      Shop[]                     @relation("ShopOwner")
  technicianProfile               TechnicianProfile?
  customerProfile                 CustomerProfile?
  bookingOrders                   BookingOrder[]             @relation("BookingOrderCustomer")
  orderHistories                  OrderStatusHistory[]       @relation("OrderStatusHistoryActor")
  pricingModeUpdates              Shop[]                     @relation("ShopPricingModeUpdatedBy")
  createdTechnicianServices       TechnicianService[]        @relation("TechnicianServiceCreatedBy")
  updatedTechnicianServices       TechnicianService[]        @relation("TechnicianServiceUpdatedBy")
  reportedOrderFinancials         OrderFinancial[]           @relation("OrderFinancialIncomeReporter")
  confirmedOrderFinancials        OrderFinancial[]           @relation("OrderFinancialIncomeConfirmer")
  confirmedBookingPayments        BookingOrder[]             @relation("BookingOrderPaymentConfirmer")
  refundedBookingPayments         BookingOrder[]             @relation("BookingOrderPaymentRefunder")
  generatedPayRuns                PayRun[]                   @relation("PayRunGeneratedBy")
  approvedPayRuns                 PayRun[]                   @relation("PayRunApprovedBy")
  createdPayslipLines             PayslipLine[]              @relation("PayslipLineCreatedBy")
  createdPayoutRecords            PayoutRecord[]             @relation("PayoutRecordCreatedBy")
  requestedPayrollAdjustments     PayrollAdjustmentRequest[] @relation("PayrollAdjustmentRequestedBy")
  approvedPayrollAdjustments      PayrollAdjustmentRequest[] @relation("PayrollAdjustmentApprovedBy")
  rejectedPayrollAdjustments      PayrollAdjustmentRequest[] @relation("PayrollAdjustmentRejectedBy")
  createdConversations            Conversation[]             @relation("ConversationCreator")
  conversationParticipants        ConversationParticipant[]
  sentMessages                    Message[]                  @relation("MessageSender")
  messageReactions                MessageReaction[]
  ownedContacts                   Contact[]                  @relation("ContactOwner")
  contactEntries                  Contact[]                  @relation("ContactUser")
  sentFriendRequests              FriendRequest[]            @relation("FriendRequestRequester")
  receivedFriendRequests          FriendRequest[]            @relation("FriendRequestTarget")
  socialPosts                     SocialPost[]               @relation("SocialPostAuthor")
  following                       Follow[]                   @relation("FollowFollower")
  followers                       Follow[]                   @relation("FollowFollowing")
  receivedNotifications           Notification[]             @relation("NotificationRecipient")
  actedNotifications              Notification[]             @relation("NotificationActor")
  ownedMerchantAccounts           MerchantAccount[]          @relation("MerchantAccountOwner")
  createdMerchantMemberships      MerchantShopMembership[]   @relation("MerchantMembershipCreatedBy")
  removedMerchantMemberships      MerchantShopMembership[]   @relation("MerchantMembershipRemovedBy")
  createdSaasFreePeriods          SaasFreePeriod[]           @relation("SaasFreePeriodCreatedBy")
  reviewedSaasPayments            SaasPayment[]              @relation("SaasPaymentReviewedBy")
  createdEntitySuspensions        EntitySuspension[]         @relation("EntitySuspensionCreatedBy")
  releasedEntitySuspensions       EntitySuspension[]         @relation("EntitySuspensionReleasedBy")
  reviewedAffiliateTasks          AffiliateTask[]            @relation("AffiliateTaskReviewer")
  affiliateClaims                 AffiliateClaim[]           @relation("AffiliateClaimUser")
  affiliateTouchesAsClaimant      AffiliateTouch[]           @relation("AffiliateTouchClaimant")
  affiliateTouchesAsCustomer      AffiliateTouch[]           @relation("AffiliateTouchCustomer")
  affiliateAttributionsClaimed    AffiliateAttribution[]     @relation("AffiliateAttributionClaimant")
  affiliateAttributionsAsCustomer AffiliateAttribution[]     @relation("AffiliateAttributionCustomer")
  reviewedAffiliateRisks          AffiliateRiskEvent[]       @relation("AffiliateRiskReviewer")

  @@index([email])
  @@index([phone])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

model Category {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(100)
  name      String    @db.VarChar(120)
  nameJa    String?   @map("name_ja") @db.VarChar(120)
  nameEn    String?   @map("name_en") @db.VarChar(120)
  parentId  Int?      @map("parent_id")
  iconUrl   String?   @map("icon_url") @db.VarChar(500)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  parent             Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children           Category[]          @relation("CategoryTree")
  services           Service[]
  technicianServices TechnicianService[]
  mediaAssets        MediaAsset[]

  @@index([parentId])
  @@index([sortOrder])
  @@index([isActive])
  @@index([deletedAt])
  @@map("categories")
}

model Shop {
  id                           Int             @id @default(autoincrement())
  ownerUserId                  Int?            @map("owner_user_id")
  name                         String          @db.VarChar(160)
  description                  String?         @db.Text
  city                         String          @db.VarChar(100)
  address                      String          @db.VarChar(255)
  latitude                     Decimal?        @db.Decimal(10, 7)
  longitude                    Decimal?        @db.Decimal(10, 7)
  phone                        String?         @db.VarChar(32)
  status                       String          @default("published") @db.VarChar(50)
  isRecommended                Boolean         @default(false) @map("is_recommended")
  pricingMode                  ShopPricingMode @default(MERCHANT) @map("pricing_mode")
  technicianPricingRatePercent Int             @default(100) @map("technician_pricing_rate_percent")
  pricingModeUpdatedAt         DateTime?       @map("pricing_mode_updated_at")
  pricingModeUpdatedBy         Int?            @map("pricing_mode_updated_by")
  createdAt                    DateTime        @default(now()) @map("created_at")
  updatedAt                    DateTime        @updatedAt @map("updated_at")
  deletedAt                    DateTime?       @map("deleted_at")

  owner                   User?                           @relation("ShopOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  pricingModeUpdater      User?                           @relation("ShopPricingModeUpdatedBy", fields: [pricingModeUpdatedBy], references: [id], onDelete: SetNull)
  services                Service[]
  technicianServices      TechnicianService[]
  technicians             TechnicianProfile[]
  mediaAssets             MediaAsset[]
  reviewSummary           ReviewSummary?
  availabilities          Availability[]
  scheduleSlots           ScheduleSlot[]
  bookingOrders           BookingOrder[]
  financeRuleSets         ShopFinanceRuleSet[]
  compensationProfiles    TechnicianCompensationProfile[]
  payRuns                 PayRun[]
  payslips                Payslip[]
  payoutRecords           PayoutRecord[]
  payrollAdjustments      PayrollAdjustmentRequest[]
  merchantMemberships     MerchantShopMembership[]
  saasBillingProfiles     SaasBillingProfile[]
  payerSaasInvoices       SaasInvoice[]
  saasInvoiceLines        SaasInvoiceLine[]
  entitySuspensions       EntitySuspension[]
  publishedAffiliateTasks AffiliateTask[]                 @relation("AffiliateShopPublisher")
  affiliateTaskScopes     AffiliateTaskShop[]
  affiliateServiceScopes  AffiliateTaskService[]
  affiliateTouches        AffiliateTouch[]
  affiliateAttributions   AffiliateAttribution[]

  @@index([ownerUserId])
  @@index([city])
  @@index([status])
  @@index([isRecommended])
  @@index([pricingMode])
  @@index([pricingModeUpdatedBy])
  @@index([deletedAt])
  @@map("shops")
}

model ShopFinanceRuleSet {
  id                    Int       @id @default(autoincrement())
  shopId                Int       @map("shop_id")
  name                  String    @db.VarChar(160)
  status                String    @default("active") @db.VarChar(40)
  wageMode              String    @default("commission") @map("wage_mode") @db.VarChar(60)
  baseSalaryJpy         Int       @default(0) @map("base_salary_jpy")
  hourlyRateJpy         Int       @default(0) @map("hourly_rate_jpy")
  dailyRateJpy          Int       @default(0) @map("daily_rate_jpy")
  fixedOrderPayJpy      Int       @default(0) @map("fixed_order_pay_jpy")
  commissionRateBps     Int       @default(6000) @map("commission_rate_bps")
  guaranteedMinimumJpy  Int       @default(0) @map("guaranteed_minimum_jpy")
  ndpFeeBearer          String    @default("shop") @map("ndp_fee_bearer") @db.VarChar(40)
  technicianNdpShareBps Int       @default(0) @map("technician_ndp_share_bps")
  bonusRulesJson        Json?     @map("bonus_rules_json")
  deductionRulesJson    Json?     @map("deduction_rules_json")
  effectiveFrom         DateTime? @map("effective_from")
  effectiveTo           DateTime? @map("effective_to")
  createdById           Int?      @map("created_by_id")
  updatedById           Int?      @map("updated_by_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@index([shopId])
  @@index([status])
  @@index([wageMode])
  @@index([ndpFeeBearer])
  @@index([createdById])
  @@index([updatedById])
  @@index([effectiveFrom, effectiveTo])
  @@index([deletedAt])
  @@map("shop_finance_rule_sets")
}

model TechnicianCompensationProfile {
  id                    Int       @id @default(autoincrement())
  shopId                Int       @map("shop_id")
  technicianProfileId   Int       @map("technician_profile_id")
  name                  String    @db.VarChar(160)
  status                String    @default("active") @db.VarChar(40)
  version               Int       @default(1)
  wageMode              String    @default("commission") @map("wage_mode") @db.VarChar(60)
  baseSalaryJpy         Int       @default(0) @map("base_salary_jpy")
  hourlyRateJpy         Int       @default(0) @map("hourly_rate_jpy")
  dailyRateJpy          Int       @default(0) @map("daily_rate_jpy")
  fixedOrderPayJpy      Int       @default(0) @map("fixed_order_pay_jpy")
  commissionRateBps     Int       @default(6000) @map("commission_rate_bps")
  guaranteedMinimumJpy  Int       @default(0) @map("guaranteed_minimum_jpy")
  ndpFeeBearer          String    @default("shop") @map("ndp_fee_bearer") @db.VarChar(40)
  technicianNdpShareBps Int       @default(0) @map("technician_ndp_share_bps")
  bonusRulesJson        Json?     @map("bonus_rules_json")
  deductionRulesJson    Json?     @map("deduction_rules_json")
  effectiveFrom         DateTime? @map("effective_from")
  effectiveTo           DateTime? @map("effective_to")
  createdById           Int?      @map("created_by_id")
  updatedById           Int?      @map("updated_by_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  shop              Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  technicianProfile TechnicianProfile @relation(fields: [technicianProfileId], references: [id], onDelete: Restrict)
  payslips          Payslip[]

  @@index([shopId])
  @@index([technicianProfileId])
  @@index([shopId, technicianProfileId, status])
  @@index([status])
  @@index([wageMode])
  @@index([ndpFeeBearer])
  @@index([createdById])
  @@index([updatedById])
  @@index([effectiveFrom, effectiveTo])
  @@index([deletedAt])
  @@map("technician_compensation_profiles")
}

model TechnicianProfile {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique @map("user_id")
  shopId          Int?      @map("shop_id")
  displayName     String    @map("display_name") @db.VarChar(120)
  bio             String?   @db.Text
  city            String    @db.VarChar(100)
  serviceArea     String?   @map("service_area") @db.VarChar(255)
  yearsExperience Int       @default(0) @map("years_experience")
  status          String    @default("published") @db.VarChar(50)
  isRecommended   Boolean   @default(false) @map("is_recommended")
  verifiedAt      DateTime? @map("verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  user                 User                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  shop                 Shop?                           @relation(fields: [shopId], references: [id], onDelete: SetNull)
  services             Service[]
  technicianServices   TechnicianService[]
  mediaAssets          MediaAsset[]
  reviewSummary        ReviewSummary?
  availabilities       Availability[]
  scheduleSlots        ScheduleSlot[]
  bookingOrders        BookingOrder[]
  compensationProfiles TechnicianCompensationProfile[]
  payslips             Payslip[]
  payoutRecords        PayoutRecord[]
  payrollAdjustments   PayrollAdjustmentRequest[]

  @@index([shopId])
  @@index([city])
  @@index([status])
  @@index([isRecommended])
  @@index([deletedAt])
  @@map("technician_profiles")
}

model CustomerProfile {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique @map("user_id")
  displayName     String    @map("display_name") @db.VarChar(120)
  bio             String?   @db.Text
  city            String?   @db.VarChar(100)
  membershipLevel String    @default("standard") @map("membership_level") @db.VarChar(50)
  isPublic        Boolean   @default(true) @map("is_public")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  mediaAssets   MediaAsset[]
  reviewSummary ReviewSummary?

  @@index([city])
  @@index([isPublic])
  @@index([deletedAt])
  @@map("customer_profiles")
}

model Service {
  id                  Int       @id @default(autoincrement())
  categoryId          Int       @map("category_id")
  shopId              Int       @map("shop_id")
  technicianProfileId Int?      @map("technician_profile_id")
  name                String    @db.VarChar(160)
  description         String?   @db.Text
  city                String    @db.VarChar(100)
  serviceMode         String    @default("store") @map("service_mode") @db.VarChar(50)
  priceAmount         Decimal   @map("price_amount") @db.Decimal(10, 2)
  currency            String    @default("JPY") @db.VarChar(3)
  durationMinutes     Int       @map("duration_minutes")
  status              String    @default("published") @db.VarChar(50)
  isRecommended       Boolean   @default(false) @map("is_recommended")
  sortOrder           Int       @default(0) @map("sort_order")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  shop                  Shop                   @relation(fields: [shopId], references: [id], onDelete: Restrict)
  technicianProfile     TechnicianProfile?     @relation(fields: [technicianProfileId], references: [id], onDelete: SetNull)
  mediaAssets           MediaAsset[]
  reviewSummary         ReviewSummary?
  scheduleSlots         ScheduleSlot[]
  bookingOrders         BookingOrder[]
  technicianServices    TechnicianService[]    @relation("TechnicianServiceSourceShopService")
  affiliateTaskScopes   AffiliateTaskService[]
  affiliateTouches      AffiliateTouch[]
  affiliateAttributions AffiliateAttribution[]

  @@index([categoryId])
  @@index([shopId])
  @@index([technicianProfileId])
  @@index([city])
  @@index([status])
  @@index([isRecommended])
  @@index([priceAmount])
  @@index([deletedAt])
  @@map("services")
}

model TechnicianService {
  id                  Int                           @id @default(autoincrement())
  shopId              Int                           @map("shop_id")
  technicianId        Int                           @map("technician_id")
  sourceShopServiceId Int?                          @map("source_shop_service_id")
  name                String                        @db.VarChar(160)
  description         String?                       @db.Text
  categoryId          Int                           @map("category_id")
  priceAmount         Int                           @map("price_amount")
  currency            String                        @default("JPY") @db.VarChar(3)
  durationMinutes     Int                           @map("duration_minutes")
  coverImageUrl       String?                       @map("cover_image_url") @db.VarChar(500)
  imagesJson          Json?                         @map("images_json")
  tagsJson            Json?                         @map("tags_json")
  isActive            Boolean                       @default(true) @map("is_active")
  isBookable          Boolean                       @default(true) @map("is_bookable")
  isRecommended       Boolean                       @default(false) @map("is_recommended")
  sortOrder           Int                           @default(0) @map("sort_order")
  reviewStatus        TechnicianServiceReviewStatus @default(APPROVED) @map("review_status")
  rejectionReason     String?                       @map("rejection_reason") @db.VarChar(500)
  createdBy           Int?                          @map("created_by")
  updatedBy           Int?                          @map("updated_by")
  createdAt           DateTime                      @default(now()) @map("created_at")
  updatedAt           DateTime                      @updatedAt @map("updated_at")
