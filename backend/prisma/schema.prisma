generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum OrderType {
  BOOKING @map("booking")
  REQUEST @map("request")

  @@map("order_type")
}

enum BookingOrderStatus {
  PENDING    @map("pending")
  CONFIRMED  @map("confirmed")
  IN_SERVICE @map("in_service")
  COMPLETED  @map("completed")
  CANCELLED  @map("cancelled")

  @@map("booking_order_status")
}

enum ScheduleSlotStatus {
  AVAILABLE @map("available")
  BOOKED    @map("booked")
  BLOCKED   @map("blocked")

  @@map("schedule_slot_status")
}

enum ShopPricingMode {
  MERCHANT   @map("merchant")
  TECHNICIAN @map("technician")

  @@map("shop_pricing_mode")
}

enum ServiceOwnerType {
  SHOP       @map("shop")
  TECHNICIAN @map("technician")

  @@map("service_owner_type")
}

enum TechnicianServiceReviewStatus {
  DRAFT    @map("draft")
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")

  @@map("technician_service_review_status")
}

enum WalletOwnerType {
  USER     @map("user")
  SHOP     @map("shop")
  PLATFORM @map("platform")

  @@map("wallet_owner_type")
}

enum LedgerTransactionType {
  BOOKING_ACCEPT_FREEZE                @map("booking_accept_freeze")
  BOOKING_CANCEL_UNFREEZE              @map("booking_cancel_unfreeze")
  BOOKING_COMPLETE_SETTLEMENT          @map("booking_complete_settlement")
  BOOKING_MERCHANT_CANCEL_COMPENSATION @map("booking_merchant_cancel_compensation")
  SEED_CREDIT                          @map("seed_credit")

  @@map("ledger_transaction_type")
}

enum LedgerTransactionStatus {
  APPLIED @map("applied")

  @@map("ledger_transaction_status")
}

enum WalletLedgerDirection {
  AVAILABLE_CREDIT @map("available_credit")
  AVAILABLE_DEBIT  @map("available_debit")
  FREEZE           @map("freeze")
  UNFREEZE         @map("unfreeze")
  FROZEN_DEBIT     @map("frozen_debit")

  @@map("wallet_ledger_direction")
}

enum FinanceReconciliationStatus {
  PENDING  @map("pending")
  EXPORTED @map("exported")

  @@map("finance_reconciliation_status")
}

enum ConversationType {
  DIRECT @map("direct")
  GROUP  @map("group")

  @@map("conversation_type")
}

enum MessageType {
  TEXT         @map("text")
  SYSTEM       @map("system")
  ORDER_STATUS @map("order_status")

  @@map("message_type")
}

enum FriendRequestStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  REJECTED @map("rejected")

  @@map("friend_request_status")
}

enum SocialPostVisibility {
  PUBLIC    @map("public")
  FOLLOWERS @map("followers")

  @@map("social_post_visibility")
}

enum NotificationType {
  ORDER_STATUS   @map("order_status")
  FRIEND_REQUEST @map("friend_request")
  SYSTEM         @map("system")
  SOCIAL         @map("social")

  @@map("notification_type")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(255)
  phone        String?   @unique @db.VarChar(32)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  username     String    @db.VarChar(100)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  identities                UserIdentity[]
  userRoles                 UserRole[]
  loginLogs                 LoginLog[]                @relation("LoginLogUser")
  auditLogs                 AuditLog[]                @relation("AuditLogActor")
  ledgerTransactions        LedgerTransaction[]       @relation("LedgerTransactionActor")
  ownedShops                Shop[]                    @relation("ShopOwner")
  technicianProfile         TechnicianProfile?
  customerProfile           CustomerProfile?
  bookingOrders             BookingOrder[]            @relation("BookingOrderCustomer")
  orderHistories            OrderStatusHistory[]      @relation("OrderStatusHistoryActor")
  pricingModeUpdates        Shop[]                    @relation("ShopPricingModeUpdatedBy")
  createdTechnicianServices TechnicianService[]       @relation("TechnicianServiceCreatedBy")
  updatedTechnicianServices TechnicianService[]       @relation("TechnicianServiceUpdatedBy")
  createdConversations      Conversation[]            @relation("ConversationCreator")
  conversationParticipants  ConversationParticipant[]
  sentMessages              Message[]                 @relation("MessageSender")
  ownedContacts             Contact[]                 @relation("ContactOwner")
  contactEntries            Contact[]                 @relation("ContactUser")
  sentFriendRequests        FriendRequest[]           @relation("FriendRequestRequester")
  receivedFriendRequests    FriendRequest[]           @relation("FriendRequestTarget")
  socialPosts               SocialPost[]              @relation("SocialPostAuthor")
  following                 Follow[]                  @relation("FollowFollower")
  followers                 Follow[]                  @relation("FollowFollowing")
  receivedNotifications     Notification[]            @relation("NotificationRecipient")
  actedNotifications        Notification[]            @relation("NotificationActor")

  @@index([email])
  @@index([phone])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

model Category {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(100)
  name      String    @db.VarChar(120)
  nameJa    String?   @map("name_ja") @db.VarChar(120)
  nameEn    String?   @map("name_en") @db.VarChar(120)
  parentId  Int?      @map("parent_id")
  iconUrl   String?   @map("icon_url") @db.VarChar(500)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  parent             Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children           Category[]          @relation("CategoryTree")
  services           Service[]
  technicianServices TechnicianService[]
  mediaAssets        MediaAsset[]

  @@index([parentId])
  @@index([sortOrder])
  @@index([isActive])
  @@index([deletedAt])
  @@map("categories")
}

model Shop {
  id                   Int             @id @default(autoincrement())
  ownerUserId          Int?            @map("owner_user_id")
  name                 String          @db.VarChar(160)
  description          String?         @db.Text
  city                 String          @db.VarChar(100)
  address              String          @db.VarChar(255)
  latitude             Decimal?        @db.Decimal(10, 7)
  longitude            Decimal?        @db.Decimal(10, 7)
  phone                String?         @db.VarChar(32)
  status               String          @default("published") @db.VarChar(50)
  isRecommended        Boolean         @default(false) @map("is_recommended")
  pricingMode          ShopPricingMode @default(MERCHANT) @map("pricing_mode")
  technicianPricingRatePercent Int     @default(100) @map("technician_pricing_rate_percent")
  pricingModeUpdatedAt DateTime?       @map("pricing_mode_updated_at")
  pricingModeUpdatedBy Int?            @map("pricing_mode_updated_by")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  deletedAt            DateTime?       @map("deleted_at")

  owner              User?               @relation("ShopOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  pricingModeUpdater User?               @relation("ShopPricingModeUpdatedBy", fields: [pricingModeUpdatedBy], references: [id], onDelete: SetNull)
  services           Service[]
  technicianServices TechnicianService[]
  technicians        TechnicianProfile[]
  mediaAssets        MediaAsset[]
  reviewSummary      ReviewSummary?
  availabilities     Availability[]
  scheduleSlots      ScheduleSlot[]
  bookingOrders      BookingOrder[]

  @@index([ownerUserId])
  @@index([city])
  @@index([status])
  @@index([isRecommended])
  @@index([pricingMode])
  @@index([pricingModeUpdatedBy])
  @@index([deletedAt])
  @@map("shops")
}

model TechnicianProfile {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique @map("user_id")
  shopId          Int?      @map("shop_id")
  displayName     String    @map("display_name") @db.VarChar(120)
  bio             String?   @db.Text
  city            String    @db.VarChar(100)
  serviceArea     String?   @map("service_area") @db.VarChar(255)
  yearsExperience Int       @default(0) @map("years_experience")
  status          String    @default("published") @db.VarChar(50)
  isRecommended   Boolean   @default(false) @map("is_recommended")
  verifiedAt      DateTime? @map("verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  shop               Shop?               @relation(fields: [shopId], references: [id], onDelete: SetNull)
  services           Service[]
  technicianServices TechnicianService[]
  mediaAssets        MediaAsset[]
  reviewSummary      ReviewSummary?
  availabilities     Availability[]
  scheduleSlots      ScheduleSlot[]
  bookingOrders      BookingOrder[]

  @@index([shopId])
  @@index([city])
  @@index([status])
  @@index([isRecommended])
  @@index([deletedAt])
  @@map("technician_profiles")
}

model CustomerProfile {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique @map("user_id")
  displayName     String    @map("display_name") @db.VarChar(120)
  bio             String?   @db.Text
  city            String?   @db.VarChar(100)
  membershipLevel String    @default("standard") @map("membership_level") @db.VarChar(50)
  isPublic        Boolean   @default(true) @map("is_public")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  mediaAssets   MediaAsset[]
  reviewSummary ReviewSummary?

  @@index([city])
  @@index([isPublic])
  @@index([deletedAt])
  @@map("customer_profiles")
}

model Service {
  id                  Int       @id @default(autoincrement())
  categoryId          Int       @map("category_id")
  shopId              Int       @map("shop_id")
  technicianProfileId Int?      @map("technician_profile_id")
  name                String    @db.VarChar(160)
  description         String?   @db.Text
  city                String    @db.VarChar(100)
  serviceMode         String    @default("store") @map("service_mode") @db.VarChar(50)
  priceAmount         Decimal   @map("price_amount") @db.Decimal(10, 2)
  currency            String    @default("JPY") @db.VarChar(3)
  durationMinutes     Int       @map("duration_minutes")
  status              String    @default("published") @db.VarChar(50)
  isRecommended       Boolean   @default(false) @map("is_recommended")
  sortOrder           Int       @default(0) @map("sort_order")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  shop               Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  technicianProfile  TechnicianProfile?  @relation(fields: [technicianProfileId], references: [id], onDelete: SetNull)
  mediaAssets        MediaAsset[]
  reviewSummary      ReviewSummary?
  scheduleSlots      ScheduleSlot[]
  bookingOrders      BookingOrder[]
  technicianServices TechnicianService[] @relation("TechnicianServiceSourceShopService")

  @@index([categoryId])
  @@index([shopId])
  @@index([technicianProfileId])
  @@index([city])
  @@index([status])
  @@index([isRecommended])
  @@index([priceAmount])
  @@index([deletedAt])
  @@map("services")
}

model TechnicianService {
  id                  Int                           @id @default(autoincrement())
  shopId              Int                           @map("shop_id")
  technicianId        Int                           @map("technician_id")
  sourceShopServiceId Int?                          @map("source_shop_service_id")
  name                String                        @db.VarChar(160)
  description         String?                       @db.Text
  categoryId          Int                           @map("category_id")
  priceAmount         Int                           @map("price_amount")
  currency            String                        @default("JPY") @db.VarChar(3)
  durationMinutes     Int                           @map("duration_minutes")
  coverImageUrl       String?                       @map("cover_image_url") @db.VarChar(500)
  imagesJson          Json?                         @map("images_json")
  tagsJson            Json?                         @map("tags_json")
  isActive            Boolean                       @default(true) @map("is_active")
  isBookable          Boolean                       @default(true) @map("is_bookable")
  isRecommended       Boolean                       @default(false) @map("is_recommended")
  sortOrder           Int                           @default(0) @map("sort_order")
  reviewStatus        TechnicianServiceReviewStatus @default(APPROVED) @map("review_status")
  rejectionReason     String?                       @map("rejection_reason") @db.VarChar(500)
  createdBy           Int?                          @map("created_by")
  updatedBy           Int?                          @map("updated_by")
  createdAt           DateTime                      @default(now()) @map("created_at")
  updatedAt           DateTime                      @updatedAt @map("updated_at")
  deletedAt           DateTime?                     @map("deleted_at")

  shop              Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  technicianProfile TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  sourceShopService Service?          @relation("TechnicianServiceSourceShopService", fields: [sourceShopServiceId], references: [id], onDelete: SetNull)
  category          Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator           User?             @relation("TechnicianServiceCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater           User?             @relation("TechnicianServiceUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  scheduleSlots     ScheduleSlot[]
  bookingOrders     BookingOrder[]

  @@index([shopId, technicianId, isActive, deletedAt])
  @@index([shopId, isRecommended, isActive, deletedAt])
  @@index([sourceShopServiceId])
  @@index([categoryId])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([reviewStatus])
  @@index([isBookable])
  @@index([sortOrder])
  @@index([deletedAt])
  @@map("technician_services")
}

model MediaAsset {
  id                  Int       @id @default(autoincrement())
  entityType          String    @map("entity_type") @db.VarChar(50)
  entityId            Int       @map("entity_id")
  categoryId          Int?      @map("category_id")
  serviceId           Int?      @map("service_id")
  shopId              Int?      @map("shop_id")
  technicianProfileId Int?      @map("technician_profile_id")
  customerProfileId   Int?      @map("customer_profile_id")
  url                 String    @db.VarChar(500)
  mimeType            String    @default("image/jpeg") @map("mime_type") @db.VarChar(100)
  usageType           String    @default("gallery") @map("usage_type") @db.VarChar(50)
  width               Int?
  height              Int?
  altText             String?   @map("alt_text") @db.VarChar(255)
  sortOrder           Int       @default(0) @map("sort_order")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  category          Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  service           Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  shop              Shop?              @relation(fields: [shopId], references: [id], onDelete: SetNull)
  technicianProfile TechnicianProfile? @relation(fields: [technicianProfileId], references: [id], onDelete: SetNull)
  customerProfile   CustomerProfile?   @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([categoryId])
  @@index([serviceId])
  @@index([shopId])
  @@index([technicianProfileId])
  @@index([customerProfileId])
  @@index([usageType])
  @@index([deletedAt])
  @@map("media_assets")
}

model ReviewSummary {
  id                  Int       @id @default(autoincrement())
  targetType          String    @map("target_type") @db.VarChar(50)
  targetId            Int       @map("target_id")
  shopId              Int?      @unique @map("shop_id")
  serviceId           Int?      @unique @map("service_id")
  technicianProfileId Int?      @unique @map("technician_profile_id")
  customerProfileId   Int?      @unique @map("customer_profile_id")
  ratingAverage       Decimal   @default(0) @map("rating_average") @db.Decimal(3, 2)
  reviewCount         Int       @default(0) @map("review_count")
  latestReviewAt      DateTime? @map("latest_review_at")
  highlights          Json?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  shop              Shop?              @relation(fields: [shopId], references: [id], onDelete: SetNull)
  service           Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  technicianProfile TechnicianProfile? @relation(fields: [technicianProfileId], references: [id], onDelete: SetNull)
  customerProfile   CustomerProfile?   @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)

  @@unique([targetType, targetId])
  @@index([shopId])
  @@index([serviceId])
  @@index([technicianProfileId])
  @@index([customerProfileId])
  @@index([ratingAverage])
  @@index([deletedAt])
  @@map("review_summaries")
}

model Availability {
  id                  Int       @id @default(autoincrement())
  shopId              Int       @map("shop_id")
  technicianProfileId Int?      @map("technician_profile_id")
  startsAt            DateTime  @map("starts_at")
  endsAt              DateTime  @map("ends_at")
  capacity            Int       @default(1)
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  technicianProfile TechnicianProfile? @relation(fields: [technicianProfileId], references: [id], onDelete: SetNull)
  scheduleSlots     ScheduleSlot[]

  @@index([shopId])
  @@index([technicianProfileId])
  @@index([startsAt, endsAt])
  @@index([isActive])
  @@index([deletedAt])
  @@map("availabilities")
}

model ScheduleSlot {
  id                  Int                @id @default(autoincrement())
  availabilityId      Int?               @map("availability_id")
  serviceId           Int?               @map("service_id")
  technicianServiceId Int?               @map("technician_service_id")
  shopId              Int                @map("shop_id")
  technicianProfileId Int?               @map("technician_profile_id")
  startsAt            DateTime           @map("starts_at")
  endsAt              DateTime           @map("ends_at")
  capacity            Int                @default(1)
  bookedCount         Int                @default(0) @map("booked_count")
  status              ScheduleSlotStatus @default(AVAILABLE)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  deletedAt           DateTime?          @map("deleted_at")

  availability      Availability?      @relation(fields: [availabilityId], references: [id], onDelete: SetNull)
  service           Service?           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  technicianService TechnicianService? @relation(fields: [technicianServiceId], references: [id], onDelete: Restrict)
  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  technicianProfile TechnicianProfile? @relation(fields: [technicianProfileId], references: [id], onDelete: SetNull)
  bookingOrders     BookingOrder[]

  @@index([availabilityId])
  @@index([serviceId])
  @@index([technicianServiceId])
  @@index([shopId])
  @@index([technicianProfileId])
  @@index([startsAt, endsAt])
  @@index([status])
  @@index([deletedAt])
  @@map("schedule_slots")
}

model BookingOrder {
  id                      Int                @id @default(autoincrement())
  orderNo                 String             @unique @map("order_no") @db.VarChar(40)
  orderType               OrderType          @default(BOOKING) @map("order_type")
  customerUserId          Int                @map("customer_user_id")
  serviceId               Int?               @map("service_id")
  technicianServiceId     Int?               @map("technician_service_id")
  shopId                  Int                @map("shop_id")
  technicianProfileId     Int?               @map("technician_profile_id")
  scheduleSlotId          Int                @map("schedule_slot_id")
  status                  BookingOrderStatus @default(PENDING)
  fulfillmentMode         String             @default("store") @map("fulfillment_mode") @db.VarChar(50)
  priceAmount             Decimal            @map("price_amount") @db.Decimal(10, 2)
  currency                String             @default("JPY") @db.VarChar(3)
  pricingModeSnapshot     ShopPricingMode    @default(MERCHANT) @map("pricing_mode_snapshot")
  serviceOwnerType        ServiceOwnerType   @default(SHOP) @map("service_owner_type")
  serviceOwnerId          Int?               @map("service_owner_id")
  serviceNameSnapshot     String?            @map("service_name_snapshot") @db.VarChar(160)
  servicePriceSnapshot    Decimal?           @map("service_price_snapshot") @db.Decimal(10, 2)
  serviceDurationSnapshot Int?               @map("service_duration_snapshot")
  serviceSnapshotJson     Json?              @map("service_snapshot_json")
  startsAt                DateTime           @map("starts_at")
  endsAt                  DateTime           @map("ends_at")
  note                    String?            @db.VarChar(500)
  cancelReason            String?            @map("cancel_reason") @db.VarChar(500)
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  deletedAt               DateTime?          @map("deleted_at")

  customer          User                 @relation("BookingOrderCustomer", fields: [customerUserId], references: [id], onDelete: Restrict)
  service           Service?             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  technicianService TechnicianService?   @relation(fields: [technicianServiceId], references: [id], onDelete: Restrict)
  shop              Shop                 @relation(fields: [shopId], references: [id], onDelete: Restrict)
  technicianProfile TechnicianProfile?   @relation(fields: [technicianProfileId], references: [id], onDelete: SetNull)
  scheduleSlot      ScheduleSlot         @relation(fields: [scheduleSlotId], references: [id], onDelete: Restrict)
  statusHistory     OrderStatusHistory[]

  @@index([customerUserId])
  @@index([serviceId])
  @@index([technicianServiceId])
  @@index([shopId])
  @@index([technicianProfileId])
  @@index([scheduleSlotId])
  @@index([status])
  @@index([orderType])
  @@index([pricingModeSnapshot])
  @@index([serviceOwnerType, serviceOwnerId])
  @@index([startsAt, endsAt])
  @@index([deletedAt])
  @@map("booking_orders")
}

model OrderStatusHistory {
  id             Int                 @id @default(autoincrement())
  bookingOrderId Int                 @map("booking_order_id")
  fromStatus     BookingOrderStatus? @map("from_status")
  toStatus       BookingOrderStatus  @map("to_status")
  actorUserId    Int?                @map("actor_user_id")
  reason         String?             @db.VarChar(500)
  metadata       Json?
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")

  bookingOrder BookingOrder @relation(fields: [bookingOrderId], references: [id], onDelete: Restrict)
  actor        User?        @relation("OrderStatusHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([bookingOrderId])
  @@index([actorUserId])
  @@index([toStatus])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("order_status_histories")
}

model Conversation {
  id              Int              @id @default(autoincrement())
  type            ConversationType @default(DIRECT)
  title           String?          @db.VarChar(120)
  createdByUserId Int?             @map("created_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  createdBy    User?                     @relation("ConversationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([type])
  @@index([createdByUserId])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("conversations")
}

model ConversationParticipant {
  id                Int       @id @default(autoincrement())
  conversationId    Int       @map("conversation_id")
  userId            Int       @map("user_id")
  role              String    @default("member") @db.VarChar(50)
  unreadCount       Int       @default(0) @map("unread_count")
  lastReadMessageId Int?      @map("last_read_message_id")
  lastReadAt        DateTime? @map("last_read_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  lastReadMessage Message?     @relation("ParticipantLastReadMessage", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@index([lastReadMessageId])
  @@index([deletedAt])
  @@map("conversation_participants")
}

model Message {
  id             Int         @id @default(autoincrement())
  conversationId Int         @map("conversation_id")
  senderUserId   Int?        @map("sender_user_id")
  type           MessageType @default(TEXT)
  content        String?     @db.Text
  metadata       Json?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")

  conversation Conversation              @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender       User?                     @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  readMarkers  ConversationParticipant[] @relation("ParticipantLastReadMessage")

  @@index([conversationId, id])
  @@index([senderUserId])
  @@index([type])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("messages")
}

model Contact {
  id            Int       @id @default(autoincrement())
  ownerUserId   Int       @map("owner_user_id")
  contactUserId Int       @map("contact_user_id")
  nickname      String?   @db.VarChar(120)
  source        String    @default("manual") @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  owner       User @relation("ContactOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  contactUser User @relation("ContactUser", fields: [contactUserId], references: [id], onDelete: Restrict)

  @@unique([ownerUserId, contactUserId])
  @@index([ownerUserId])
  @@index([contactUserId])
  @@index([deletedAt])
  @@map("contacts")
}

model FriendRequest {
  id              Int                 @id @default(autoincrement())
  requesterUserId Int                 @map("requester_user_id")
  targetUserId    Int                 @map("target_user_id")
  status          FriendRequestStatus @default(PENDING)
  message         String?             @db.VarChar(300)
  respondedAt     DateTime?           @map("responded_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  deletedAt       DateTime?           @map("deleted_at")

  requester User @relation("FriendRequestRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  target    User @relation("FriendRequestTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([requesterUserId])
  @@index([targetUserId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("friend_requests")
}

model SocialPost {
  id           Int                  @id @default(autoincrement())
  authorUserId Int                  @map("author_user_id")
  content      String               @db.Text
  media        Json?
  visibility   SocialPostVisibility @default(PUBLIC)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")

  author User @relation("SocialPostAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([authorUserId])
  @@index([visibility])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("social_posts")
}

model Follow {
  id              Int       @id @default(autoincrement())
  followerUserId  Int       @map("follower_user_id")
  followingUserId Int       @map("following_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  follower  User @relation("FollowFollower", fields: [followerUserId], references: [id], onDelete: Restrict)
  following User @relation("FollowFollowing", fields: [followingUserId], references: [id], onDelete: Restrict)

  @@unique([followerUserId, followingUserId])
  @@index([followerUserId])
  @@index([followingUserId])
  @@index([deletedAt])
  @@map("follows")
}

model Notification {
  id              Int              @id @default(autoincrement())
  recipientUserId Int              @map("recipient_user_id")
  actorUserId     Int?             @map("actor_user_id")
  type            NotificationType
  title           String           @db.VarChar(160)
  body            String           @db.VarChar(500)
  payload         Json?
  readAt          DateTime?        @map("read_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  recipient User  @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  actor     User? @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([recipientUserId])
  @@index([actorUserId])
  @@index([type])
  @@index([readAt])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("notifications")
}

model UserIdentity {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  type        String    @db.VarChar(50)
  scopeType   String?   @map("scope_type") @db.VarChar(50)
  scopeId     Int?      @map("scope_id")
  displayName String?   @map("display_name") @db.VarChar(100)
  isDefault   Boolean   @default(false) @map("is_default")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([type])
  @@index([scopeType, scopeId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("user_identities")
}

model Role {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  code        String    @unique @db.VarChar(100)
  description String?   @db.VarChar(500)
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([code])
  @@index([isSystem])
  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  code        String    @unique @db.VarChar(100)
  type        String    @db.VarChar(50)
  module      String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  rolePermissions RolePermission[]

  @@index([code])
  @@index([type])
  @@index([module])
  @@index([isSystem])
  @@index([deletedAt])
  @@map("permissions")
}

model UserRole {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  roleId    Int       @map("role_id")
  scopeType String?   @map("scope_type") @db.VarChar(50)
  scopeId   Int?      @map("scope_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([userId])
  @@index([roleId])
  @@index([scopeType, scopeId])
  @@index([deletedAt])
  @@map("user_roles")
}

model RolePermission {
  id           Int       @id @default(autoincrement())
  roleId       Int       @map("role_id")
  permissionId Int       @map("permission_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@index([deletedAt])
  @@map("role_permissions")
}

model LoginLog {
  id         Int       @id @default(autoincrement())
  userId     Int?      @map("user_id")
  email      String    @db.VarChar(255)
  ip         String    @db.VarChar(50)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  status     String    @db.VarChar(20)
  failReason String?   @map("fail_reason") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  user User? @relation("LoginLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("login_logs")
}

model AuditLog {
  id         Int       @id @default(autoincrement())
  actorId    Int?      @map("actor_id")
  action     String    @db.VarChar(100)
  targetType String    @map("target_type") @db.VarChar(100)
  targetId   Int?      @map("target_id")
  ip         String?   @db.VarChar(50)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("audit_logs")
}

model Wallet {
  id               Int             @id @default(autoincrement())
  ownerType        WalletOwnerType @map("owner_type")
  ownerId          Int             @map("owner_id")
  currency         String          @default("NDP") @db.VarChar(10)
  availableBalance Int             @default(0) @map("available_balance")
  frozenBalance    Int             @default(0) @map("frozen_balance")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  deletedAt        DateTime?       @map("deleted_at")

  ledgerEntries WalletLedger[]

  @@unique([ownerType, ownerId, currency])
  @@index([ownerType, ownerId])
  @@index([currency])
  @@index([deletedAt])
  @@map("wallets")
}

model LedgerTransaction {
  id             Int                     @id @default(autoincrement())
  transactionNo  String                  @unique @map("transaction_no") @db.VarChar(40)
  idempotencyKey String                  @unique @map("idempotency_key") @db.VarChar(160)
  type           LedgerTransactionType
  status         LedgerTransactionStatus @default(APPLIED)
  referenceType  String                  @map("reference_type") @db.VarChar(80)
  referenceId    Int                     @map("reference_id")
  actorUserId    Int?                    @map("actor_user_id")
  amount         Int
  currency       String                  @default("NDP") @db.VarChar(10)
  metadata       Json?
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  deletedAt      DateTime?               @map("deleted_at")

  actor          User?                  @relation("LedgerTransactionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  entries        WalletLedger[]
  reconciliation FinanceReconciliation?

  @@index([type])
  @@index([status])
  @@index([referenceType, referenceId])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("ledger_transactions")
}

model WalletLedger {
  id                    Int                   @id @default(autoincrement())
  walletId              Int                   @map("wallet_id")
  transactionId         Int                   @map("transaction_id")
  direction             WalletLedgerDirection
  amount                Int
  availableDelta        Int                   @map("available_delta")
  frozenDelta           Int                   @map("frozen_delta")
  availableBalanceAfter Int                   @map("available_balance_after")
  frozenBalanceAfter    Int                   @map("frozen_balance_after")
  reason                String                @db.VarChar(160)
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  deletedAt             DateTime?             @map("deleted_at")

  wallet      Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)
  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([walletId])
  @@index([transactionId])
  @@index([direction])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("wallet_ledgers")
}

model FinanceReconciliation {
  id               Int                         @id @default(autoincrement())
  transactionId    Int                         @unique @map("transaction_id")
  referenceType    String                      @map("reference_type") @db.VarChar(80)
  referenceId      Int                         @map("reference_id")
  status           FinanceReconciliationStatus @default(PENDING)
  currency         String                      @default("NDP") @db.VarChar(10)
  expectedAmount   Int                         @map("expected_amount")
  actualAmount     Int                         @map("actual_amount")
  differenceAmount Int                         @default(0) @map("difference_amount")
  exportedAt       DateTime?                   @map("exported_at")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")
  deletedAt        DateTime?                   @map("deleted_at")

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([referenceType, referenceId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("finance_reconciliations")
}
