model ShopMembershipCardRedemption {
  id                        Int                                @id @default(autoincrement())
  publicId                  String                             @unique @default(uuid()) @map("public_id") @db.Char(36)
  cardId                    Int                                @map("card_id")
  shopId                    Int                                @map("shop_id")
  customerUserId            Int                                @map("customer_user_id")
  bookingOrderId            Int                                @unique(map: "shop_membership_card_redemptions_booking_order_id_key") @map("booking_order_id")
  planVersionId             Int                                @map("plan_version_id")
  redeemedById              Int                                @map("redeemed_by_id")
  orderNoSnapshot           String                             @map("order_no_snapshot") @db.VarChar(40)
  serviceNameSnapshot       String                             @map("service_name_snapshot") @db.VarChar(160)
  servicePublicId           String?                            @map("service_public_id") @db.Char(36)
  serviceCategoryCode       String?                            @map("service_category_code") @db.VarChar(80)
  serviceStartedAt          DateTime                           @map("service_started_at")
  serviceCompletedAt        DateTime                           @map("service_completed_at")
  eligibleAmountJpy         Int                                @map("eligible_amount_jpy")
  consumedPrincipalJpy      Int                                @default(0) @map("consumed_principal_jpy")
  consumedUses              Int                                @default(0) @map("consumed_uses")
  principalBalanceBeforeJpy Int?                               @map("principal_balance_before_jpy")
  principalBalanceAfterJpy  Int?                               @map("principal_balance_after_jpy")
  remainingUsesBefore       Int?                               @map("remaining_uses_before")
  remainingUsesAfter        Int?                               @map("remaining_uses_after")
  cardLockVersionBefore     Int                                @map("card_lock_version_before")
  rewardFacts               Json                               @map("reward_facts")
  rewardHits                Json                               @map("reward_hits")
  rawRewardNdp              Int                                @default(0) @map("raw_reward_ndp")
  customerRewardNdp         Int                                @default(0) @map("customer_reward_ndp")
  platformFeeRateBps        Int                                @map("platform_fee_rate_bps")
